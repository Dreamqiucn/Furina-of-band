        } else if (adjustedAa === 7 && this.lastdaywt === 6) {
          console.log("更新 lastdaywt")

          storage.set({
            key: "lastdaywt",
            value: "0"
          })
          storage.set({
            key: "wt",
            value: JSON.stringify(this.newwt)
          })
          for (let i = 0; i < 4; i++) {
            const x = Math.floor(Math.random() * this.wtall.length)
            this.wt[i] = this.wtall[x]
          }
          storage.set({
            key: "wt",
            value: JSON.stringify(this.wt)
          })
          console.log("更新 wt")
        } else if (adjustedAa === this.lastdaywt) {
          storage.get({
            key: "wt",
            success: (res) => {
              this.wt = res ? JSON.parse(res) : this.newwt
            }
          })
        } else if (adjustedAa === 7 && this.lastdaywt === 0) {
          storage.get({
            key: "wt",
            success: (res) => {
              this.wt = res ? JSON.parse(res) : this.sundaywt
              storage.set({
                key: "wt",
                value: JSON.stringify(this.wt)
              })
            }
          })
        }
      }
