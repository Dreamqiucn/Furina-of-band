<template>
  <div class="download-page" @swipe="ban">
    <div class="download-page" if="{{ visible }}">
      <div class="header column center">
        <text class="a" onclick="changeName">{{ ffname }}</text>
        <text class="b">好感度 {{ level }}%</text>
        <text class="b">等级 {{ mxlv }}</text>
      </div>

      <div class="body column center">
        <image class="icon" src="{{ imgsrc }}" onclick="say"></image>
      </div>
      <div class="footer column center">
        <div class="list row">
          <input
            class="item column center"
            type="button"
            value="故事"
            style="font-size: 25px; color: #ffffff"
            onclick="routePage5"
          />
          <input
            class="item column center"
            type="button"
            value="委托"
            style="font-size: 25px; color: #ffffff"
            onclick="routePage4"
          />
        </div>
        <div class="list3 row">
          <input
            class="item column center"
            type="button"
            value="祈愿"
            style="font-size: 25px; color: #ffffff"
            onclick="routePage2"
          />
          <input
            class="item column center"
            type="button"
            value="突发事件"
            style="font-size: 20px; color: #ffffff"
            onclick="routePage3"
          />
        </div>
        <div class="list6 row">
          <input
            class="item column center"
            type="button"
            value="冒险"
            style="font-size: 25px; color: #ffffff"
            onclick="routePage7"
          />
          <input
            class="item column center"
            type="button"
            value="全部"
            style="font-size: 25px; color: #ffffff"
            onclick="routePage1"
          />
        </div>
      </div>
    </div>

    <text class="a" style="margin-top: 50px" if="{{ visible==false }}">
      你遇到彩蛋了：芙芙逛街去了，明天回来
    </text>
    <image src="/common/icon/back.png" class="back" onclick="exit"></image>
  </div>
</template>

<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"
import storage111 from "@system.storage"

export default {
  public: {
    a: 0, // 初始值设为0
    lastday: 0, // 记录上一次的星期数
    level: 0,
    mxlv: 1,
    jys: 0,
    visible: true,
    lastdayx: null,
    goaway: 0,
    name: "",
    ffname: "芙宁娜",
    imgsrc: "0", // 初始图片路径
    images: [
      "/common/icon/ff1.png",
      "/common/icon/ff2.png",
      "/common/icon/ff3.png",
      "/common/icon/ff4.png"
    ], // 图片路径数组
    currentImageIndex: null
  },

  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    storage.get({
      key: "synced",
      success: (data) => {
        if (data != "success") {
          storage111.get({
            key: "mxlv",
            success: (mx) => {
              if (mx) {
                router.push({uri: "pages/sync"})
              } else {
                console.log(data, "不需要同步")
              }
            }
          })
        } else {
          console.log(data, "不需要同步")
        }
      }
    })
    const imagechange = Math.floor(Math.random() * 4)
    if (imagechange == 1) {
      this.imgsrc = "/common/icon/ff1.png"
    } else if (imagechange == 2) {
      this.imgsrc = "/common/icon/ff2.png"
    } else if (imagechange == 3) {
      this.imgsrc = "/common/icon/ff3.png"
    } else {
      this.imgsrc = "/common/icon/ff4.png"
    }
    storage.get({
      key: "name",
      success: (res) => {
        if (res === "") {
          prompt.showToast({
            message: "请先设置你的名字",
            duration: 1000
          })
          setTimeout(() => {
            router.replace({
              uri: "pages/index_name"
            })
          }, 1000)
        } else {
          this.name = res
        }
      }
    })
    const today = new Date()
    const adjustedA = today.getDay() === 0 ? 7 : today.getDay() // 将星期数转换为1-7的格式
    storage.get({
      key: "name",
      success: (res) => {
        this.name = res
      }
    })
    // 获取 goaway 和 lastday 的值
    storage.get({
      key: "goaway",
      success: (resGoaway) => {
        this.goaway = resGoaway ? parseInt(resGoaway, 10) : 0
        // 根据 goaway 的值设置 visible
        this.visible = this.goaway === 0

        storage.get({
          key: "lastday",
          success: (resB) => {
            this.lastday = resB ? parseInt(resB, 10) : 0 // 获取并设置 lastday
            // 如果今天是新的星期，且 goaway 为 1，则将 goaway 重置为 0
            if (adjustedA !== this.lastday && adjustedA < 7 && this.goaway === 1) {
              this.goaway = 0
              storage.set({
                key: "goaway",
                value: this.goaway.toString()
              })
              this.visible = true
              prompt.showToast({
                message: "I'm back!",
                duration: 1000
              })
            } else if (adjustedA === 7 && this.lastday === 6 && this.goaway === 1) {
              this.goaway = 0
              storage.set({
                key: "goaway",
                value: this.goaway.toString()
              })
            }

            // 更新 lastday 和 level（你的原有逻辑）
            if (adjustedA !== this.lastday && adjustedA < 7) {
              storage.set({
                key: "lastday",
                value: adjustedA === 7 ? 0 : adjustedA.toString()
              })

              storage.get({
                key: "level",
                success: (resA) => {
                  this.level = resA ? parseInt(resA, 10) : 0
                  this.level += 5
                  this.say()
                  prompt.showToast({
                    message: "好感度+5%",
                    duration: 1000
                  })
                  storage.set({
                    key: "level",
                    value: this.level.toString()
                  })
                }
              })
            } else if (adjustedA === 7 && this.lastday === 6) {
              this.lastday = 0
              storage.set({
                key: "lastday",
                value: this.lastday.toString()
              })
              storage.get({
                key: "level",
                success: (resA) => {
                  this.level = resA ? parseInt(resA, 10) : 0
                  this.level += 5
                  this.say()
                  prompt.showToast({
                    message: "好感度+5%",
                    duration: 1000
                  })
                  storage.set({
                    key: "level",
                    value: this.level.toString()
                  })
                }
              })
            } else if (adjustedA === this.lastday || (adjustedA === 7 && this.lastday === 0)) {
              storage.get({
                key: "level",
                success: (resC) => {
                  this.level = resC ? parseInt(resC, 10) : 5
                }
              })
            }
          }
        })
      }
    })
    storage.get({
      key: "mxlv",
      success: (mx) => {
        this.mxlv = mx ? parseInt(mx, 10) : 1
      }
    })
  },

  getRandomGreeting(affection) {
    const greetings = [
      "你好，" + this.name + "，听闻你四处冒险，今日到此，所为何事？",
      "哟，" + this.name + "，又来枫丹了？这次打算待多久？",
      "你来了，有什么需要本小姐帮忙的吗？",
      "你好呀，" + this.name + "，我听说过你的事迹，这次来枫丹是有新任务？",
      "欢迎来到枫丹，" + this.name + "，若是有什么有趣的见闻，可别忘了和本小姐分享。",
      "嘿，" + this.name + "，你又到哪片大陆冒险了？这次来枫丹是偶然路过吗？",
      "你好，" + this.name + "，枫丹最近还算太平，你可是有什么需要尽管开口。",
      "哟，" + this.name + "，今天怎么有空来枫丹？不会是专门来找我的吧？",
      "你来了，" + this.name + "，我正打算去巡视一番，你要不要一起？",
      "欢迎欢迎，" + this.name + "，枫丹有不少好玩的地方，你有兴趣去看看吗？",
      "嘿，你终于来了！我还以为你把枫丹给忘了呢。",
      "你好呀，" + this.name + "，我最近研究了一些新的表演剧本，你想不想听听？",
      "" + this.name + "，你这次带来了什么新奇的玩意儿？快让本小姐瞧瞧。",
      "欢迎回来，" + this.name + "，枫丹的美食可不少，要不要我带你去尝尝？",
      "哟，你又来啦！这次可别这么快就走，多陪我聊聊。",
      "嘿，" + this.name + "，你冒险的时候有没有遇到过什么特别厉害的怪物？快给我讲讲。",
      "你来了，我正愁没人陪我玩呢，" + this.name + "，陪我玩会儿吧。",
      "欢迎光临，" + this.name + "，我最近学会了一种新的游戏，要不要一起试试？",
      "" + this.name + "！你可算出现了，我都等你好久了！",
      "你终于来啦，我有好多好多话想和你说，快坐下来听我讲。",
      "嘿，我的好朋友" + this.name + "，这次又给我带来了什么惊喜？",
      "你好呀，我的冒险伙伴，有没有想我这个枫丹的好朋友？",
      "欢迎回家，我的" + this.name + "，枫丹因为你的到来都变得更有趣了。",
      "哟，" + this.name + "，你要是再不来，我都要以为你被其他大陆拐跑了。",
      "嘿，" + this.name + "，我发现了一个超好玩的地方，我们一起去探险吧。",
      "欢迎，我的密友" + this.name + "，快来和我分享你的冒险故事，我都迫不及待了。",
      this.name + "你终于出现啦，我最近心情不太好，快陪我去散散心。",
      this.name + "你好呀，我的专属" + this.name + "，除了你，我都不知道该和谁说这些心里话了。",
      "欢迎回家，" + this.name + "，只有你最懂我，快和我讲讲你的冒险经历。",
      "嘿，" + this.name + "，我发现了一种神秘的力量波动，我们一起去调查一下。",
      "欢迎，我的至交" + this.name + "，没有你在，枫丹都变得无趣多了。",
      "" + this.name + "，你就是我的全世界，没有你我可怎么办呀！",
      this.name + "你终于来啦，我最近遇到了一个超级大难题，只有你能帮我。",
      this.name + "哟，你可算来了，我最近感觉好迷茫，你快给我指指路。",
      "你来了，我最近偷偷藏了一些好吃的，只和你分享哦。",
      "嘿，" + this.name + "，我想和你在一起，一起冒险，一起生活，好不好？",
      "你好，我的心灵支柱" + this.name + "，我最近压力好大，你陪我放松放松。",
      "欢迎，我的依靠" + this.name + "，以后不管发生什么，我都相信你。",
      "" + this.name + "，我们是彼此最重要的人，以后不管遇到什么，都要相互扶持。",
      "你终于来啦，我最近一直在想，要是没有你，我该怎么继续走下去。",
      "嘿，并肩作战的伙伴" + this.name + "，我们一起创造了那么多回忆，以后还要更多。",
      "你好，我的奋斗伙伴" + this.name + "，我相信只要我们在一起，就没有什么做不到的。",
      "欢迎，我的坚定盟友" + this.name + "，以后的路还很长，我们一起走。",
