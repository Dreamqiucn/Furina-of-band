      [2180, [2140, 2180], [850000000, 972000000]],
      [2220, [2180, 2220], [972000000, 1110000000]],
      [2260, [2220, 2260], [1110000000, 1270000000]],
      [2300, [2260, 2300], [1270000000, 1450000000]],
      [2340, [2300, 2340], [1450000000, 1660000000]],
      [2380, [2340, 2380], [1660000000, 1900000000]],
