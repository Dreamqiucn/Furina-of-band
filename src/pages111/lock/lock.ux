        style="position: absolute; top: 410px; left: 15px"
        @click="to('en')"
      ></image>
    </div>
    <!--二维码-->
    <div class="page" if="{{ page=='qr' }}">
      <qrcode
        value="https://www.bilibili.com/opus/1052333185858273287"
