        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "丘丘王"
            }
          })
      }, 1000)
    } else if (this.monster === 4) {
      this.realmonster = "浮游水蕈兽"
