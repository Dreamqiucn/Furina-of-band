<template>
  <div class="page" @swipe="toHomePage">
    <div class="page">
      <text class="title">故事</text>

      <list class="list" bounces="true">
        <list-item class="item center" type="custom" @click="a">
          <text class="name">官方4.2剧情 “罪人舞步旋”</text>
        </list-item>
        <list-item class="item center" type="custom" @click="b">
          <text class="name">个人制作 故事</text>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

export default {
  public: {
    level: 0
  },
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    storage.get({
      key: "level",
      success: (resC) => {
        this.level = resC ? parseInt(resC, 10) : 5
      }
    })
  },
  ridea() {
    // 跳转到应用内的某个页面，当前页面无法返回

    router.replace({
      uri: "/pages/idea"
    })
  },
  b() {
    // 跳转到应用内的某个页面，当前页面无法返回

    router.replace({
      uri: "/pages/index_novel"
    })
  },
  a() {
    // 跳转到应用内的某个页面，当前页面无法返回

    router.replace({
      uri: "/pages/index_gfjq"
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  },

  back() {
    router.replace({
      uri: "/pages/index"
    })
  }
}
</script>

