      [3540, [3500, 3540], [79320000000, 90610000000]],
      [3580, [3540, 3580], [90610000000, 103500000000]],
      [3620, [3580, 3620], [103500000000, 118200000000]],
      [3660, [3620, 3660], [118200000000, 135000000000]],
      [3700, [3660, 3700], [135000000000, 154200000000]],
