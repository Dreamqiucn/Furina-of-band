      "欢迎来到枫丹，" + this.name + "，若是有什么有趣的见闻，可别忘了和本小姐分享。",
      "嘿，" + this.name + "，你又到哪片大陆冒险了？这次来枫丹是偶然路过吗？",
      "你好，" + this.name + "，枫丹最近还算太平，你要是有什么需要尽管开口。",
      "哟，" + this.name + "，今天怎么有空来枫丹？不会是专门来找我的吧？",
      "你来了，" + this.name + "，我正打算去巡视一番，你要不要一起？",
      "欢迎欢迎，" + this.name + "，枫丹有不少好玩的地方，你有兴趣去看看吗？"
    ]

    const greetingsMediumAffection = [
      this.name + "嘿，你终于来了！我还以为你把枫丹给忘了呢。",
      "你好呀，" + this.name + "，我最近研究了一些新的表演剧本，你想不想听听？",
      "" + this.name + "，你这次带来了什么新奇的玩意儿？快让本小姐瞧瞧。",
      "欢迎回来，" + this.name + "，枫丹的美食可不少，要不要我带你去尝尝？",
      this.name + "哟，你又来啦！这次可别这么快就走，多陪我聊聊。",
      "嘿，" + this.name + "，你冒险的时候有没有遇到过什么特别厉害的怪物？快给我讲讲。",
      "你来了，我正愁没人陪我玩呢，" + this.name + "，陪我玩会儿吧。",
      "欢迎光临，" + this.name + "，我最近学会了一种新的游戏，要不要一起试试？"
    ]

    const greetingsHighAffection = [
      "" + this.name + "！你可算出现了，我都等你好久了！",
      "你终于来啦，我有好多好多话想和你说，快坐下来听我讲。",
      "嘿，我的好朋友" + this.name + "，这次又给我带来了什么惊喜？",
      this.name + "你好呀，我的冒险伙伴，有没有想我这个枫丹的好朋友？",
      "欢迎回家，我的" + this.name + "，枫丹因为你的到来都变得更有趣了。",
      "哟，" + this.name + "，你要是再不来，我都要以为你被其他大陆拐跑了。",
      "嘿，" + this.name + "，我发现了一个超好玩的地方，我们一起去探险吧。",
      "欢迎，我的密友" + this.name + "，快来和我分享你的冒险故事，我都迫不及待了。"
    ]

    const greetingsVeryFamiliar = [
      this.name + "你终于出现啦，我最近心情不太好，快陪我去散散心。",
      "你好呀，我的专属" + this.name + "，除了你，我都不知道该和谁说这些心里话了。",
      "欢迎回家，" + this.name + "，只有你最懂我，快和我讲讲你的冒险经历。",
      "嘿，" + this.name + "，我发现了一种神秘的力量波动，我们一起去调查一下。",
      "欢迎，我的至交" + this.name + "，没有你在，枫丹都变得无趣多了。"
    ]

    const greetingsCloseTrust = [
      "" + this.name + "，你就是我的全世界，没有你我可怎么办呀！",
      this.name + "你终于来啦，我最近遇到了一个超级大难题，只有你能帮我。",
      this.name + "哟，你可算来了，我最近感觉好迷茫，你快给我指指路。",
      this.name + "你来了，我最近偷偷藏了一些好吃的，只和你分享哦。",
      "嘿，" + this.name + "，我想和你在一起，一起冒险，一起生活，好不好？",
