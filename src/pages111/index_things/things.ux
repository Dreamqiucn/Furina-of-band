        })
        prompt.showToast({
          message: "芙芙今天太累了，冒险等级减少5",
          duration: 2000
        })
        if (this.mxlv > 5) {
          this.mxlv -= 5
          storage.set({
            key: "mxlv",
            value: this.mxlv.toString()
          })
        } else {
          prompt.showToast({
            message: "芙芙的等级太低了，不能减5，她只好变的不累了",
            duration: 2000
          })
        }
        break
      case 5:
        storage.get({
          key: "tfs",
          success: (result) => (this.tfs = result ? parseInt(result, 10) : 0)
        })
        storage.get({
          key: "nstf",
          success: (result) => (this.nstf = result ? parseInt(result, 10) : 0)
        })
        this.tfs += 5
        this.nstf += 5
        storage.set({
          key: "tfs",
          value: this.tfs.toString()
        })
        storage.set({
          key: "nstf",
          value: this.nstf.toString()
        })
        prompt.showToast({
          message: "芙芙今天太想进步了，经验书增加5个",
          duration: 2000
        })
        break
      case 6:
        storage.get({
          key: "jys",
