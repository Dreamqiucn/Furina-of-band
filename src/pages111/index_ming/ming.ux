<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"
export default {
  private: {
    img: "",
    which: "",
    whichtext: "",
    whichmore: "",
    currentCount: 0,
    jinglian: 0,
    weaponKey: "",
    minglevel: 0
  },
  up() {
    this.currentCount -= 1
    storage.set({
      key: "ming",
      value: this.currentCount.toString(),
      success: (data) => {
        console.log(data)
      }
    })
    storage.get({
      key: "minglevel",
      success: (data) => {
        this.minglevel = data ? parseInt(data, 10) : 0
        this.minglevel += 1
        storage.set({
          key: "minglevel",
          value: this.minglevel.toString(),
          success: (data) => {
            console.log("succeed" + data)
          }
        })
      }
    })
  },

  // 初始化方法（优化后）
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    this.whichtext =
      "命之座无特殊功能，但代表了你对芙宁娜的爱，无上限等级，真爱党可以无脑冲\n\n\n\n「爱是难驯鸟，哀乞亦无用。」\n「女人皆善变，仿若水中萍。」\n「秘密藏心间，无人知我名。」\n「若非处幽冥，怎知生可贵！」\n「我已有觉察，他名即是…！」\n「诸君听我颂，共举爱之杯！」"
    // storage.get({
    //   key: "ming",
    //   success: (data) => {
    //     const old = data ? parseInt(data, 10) : 0
    //     const newCount = old + 1
    //     storage.set({
    //       key: "ming",
    //       value: newCount
    //     })
    //     this.currentCount = newCount
    //   }
    // })
    // 初始化武器信息
    storage.get({
      key: "minglevel",
      success: (data) => {
        this.minglevel = data ? parseInt(data, 10) : 0
      }
    })
    storage.get({
      key: "ming",
      success: (res) => {
        this.currentCount = parseInt(res, 10) || 0
      }
    })

    // 检查所有武器是否精炼满
  },

  // 页面返回方法
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.back()
    }
  },

  // 返回按钮方法
  back() {
    router.back()
  }
}
</script>
