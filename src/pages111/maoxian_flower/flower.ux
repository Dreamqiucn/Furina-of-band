      [780, [740, 780], [6000000, 7200000]],
      [820, [780, 820], [7200000, 8500000]],
      [860, [820, 860], [8500000, 9900000]],
      [900, [860, 900], [9900000, 11500000]],
      [940, [900, 940], [11500000, 13200000]],
      [980, [940, 980], [13200000, 15000000]],
      [1000, [980, 1000], [8700000, 10000000]],
      [1020, [1000, 1020], [10000000, 12000000]],
      [1060, [1020, 1060], [12000000, 14500000]],
      [1100, [1060, 1100], [14500000, 17500000]],
      [1140, [1100, 1140], [17500000, 21000000]],
      [1180, [1140, 1180], [21000000, 25000000]],
      [1220, [1180, 1220], [25000000, 30000000]],
