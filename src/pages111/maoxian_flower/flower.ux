<template>
  <div class="page download-page column center" @swipe="toHomePage">
    <div class="header center" if="isContentVisible">
      <text class="vs">{{ diren }} LV {{ qqlv }} 血量：{{ qqblood }}</text>
    </div>
    <image class="icon" src="{{ imgsrc }}" if="isContentVisible" />
    <text class="vs" if="isContentVisible">
      {{ b === 1 ? "我方回合" : "敌方回合" }}
    </text>
    <text if="isContentVisible" style="font-size: 22px; color: #ffffff">血量：{{ blood }}</text>
    <image class="character" src="/common/icon/newdo.png" if="isContentVisible" />

    <div class="footer column center" if="isContentVisible">
      <div>
        <image
          class="eq"
          src="/common/icon/a.png"
          @click="ak1"
          onlongpress="change"
          if="ak22 >= 0 && visible === true"
        />
        <image
          class="eq"
          src="/common/icon/e.png"
          @click="ak2"
          if="ak22 === 0 && visible === true && eee === true"
        />
        <image
          class="eq"
          src="/common/icon/e2.png"
          @click="upblood"
          if="ak22 === 0 && visible === true && eee === false"
        />
        <image
          class="eq"
          src="/common/icon/q.png"
          @click="ak3"
          if="ak33 === 0 && visible === true"
        />
        <image class="eq" src="/common/icon/jfood.png" @click="up" if="visible === true" />
        <div class="center column">
          <text class="vs" style="color: #a1a1a1" if="visible === true">剩余</text>
          <text class="vs" style="color: #a1a1a1" if="visible === true">{{ j }}个</text>
        </div>
      </div>
      <text class="vs">E还需{{ ak22 }}层 Q还需{{ ak33 }}层</text>
    </div>
  </div>
</template>

<style>
.back {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 72px;
  height: 72px;
  opacity: 0.5;
}

/* 样式定义区域 */
.item {
  display: flex;
  justify-content: flex-end;
  /* 向右对齐 */
  align-items: center;
}

.download-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.eq {
  width: 100%;
}

.center {
  align-items: center;
  justify-content: center;
}

.page {
  flex: 1;
  padding: 10px;
  background-color: #000000;
  width: 192px;
  height: 480px;
}

.icon2 {
  width: 64px;
  height: 64px;
}

.button {
  position: absolute;
  top: 15px;
  right: 15px;
  background-color: rgba(255, 255, 255, 0.2);
  border: none;
  color: white;
  padding: 5px 10px;
  border-radius: 10px;
}

.icon {
  width: 70px;
  height: 40px;
  margin: 10px auto;
}

.vs {
  font-size: 20px;
}

.character {
  width: 50px;
  height: 90px;
}

.eq {
  width: 50px;
  height: 50px;
}

.footer {
  width: 100%;
  display: flex;
  justify-content: space-around;
}
</style>

<script>
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

export default {
  public: {
    /* 公共变量声明 */
    diren: "",
    imgsrc: "",
    visible: true,
    qqlv: 0,
    qqblood: 0,
    blood: 0,
    aka: 0,
    ake: 0,
    akq: 0,
    a: 1,
    b: 1,
    ak22: 1,
    ak33: 2,
    isContentVisible: true,
    j: 0,
    eee: true,
    currentTextIndex: null, // 当前显示的文本索引
    etext: ["芙芙已切换到芒性", "芙芙已切换到荒性"]
  },
  change() {
    this.eee = !this.eee

    prompt.showToast({
      message: this.etext[this.currentTextIndex],
      duration: 1000
    })
    this.currentTextIndex = (this.currentTextIndex + 1) % this.etext.length
    setTimeout(() => this.processEnemyTurn(), 1500)
    this.visible = false
  },
  upblood() {
    if (this.ak22 === 0) {
      this.b = 0
      this.blood += Math.round(this.ake / 5)
      prompt.showToast({
        message: "芙宁娜回复了" + Math.round(this.ake / 5) + "点血量",
        duration: 500
      })

      this.ak22 += 2
      this.ak33 = Math.max(this.ak33 - 1, 0)
      setTimeout(() => this.processEnemyTurn(), 1500)
      this.visible = false
      if (this.qqblood <= 0) {
        router.replace({
          uri: "/pages/explore_goods"
        })
      }
    }
  },
  /* 处理敌方回合 */
  processEnemyTurn() {
    this.visible = true
    const damage = Math.floor(Math.random() * (this.qqlv * 10 + 1)) + this.qqlv * 10
    this.blood -= damage
    this.b = 1
    prompt.showToast({
      message: "敌方造成" + damage + "点伤害",
      duration: 500
    })
    if (this.blood <= 0) {
      this.handleGameOver("/pages/maoxian_over")
    }
  },
  up() {
    if (this.b === 1 && this.j > 0) {
      this.blood += 1000
      this.j -= 1
      storage.set({
        key: "j",
        value: this.j.toString()
      })
    }
  },
  /* 进行A攻击 */
  ak1() {
    if (this.b === 1) {
      this.b = 0
      this.ak22 = Math.max(this.ak22 - 1, 0)
      this.qqblood -= this.aka
      prompt.showToast({
        message: "芙宁娜造成" + this.aka + "点伤害",
        duration: 500
      })
      setTimeout(() => this.processEnemyTurn(), 1500)
      this.visible = false
      if (this.qqblood <= 0) {
        router.replace({
          uri: "/pages/explore_goods"
        })
      }
    }
  },

  /* 进行E攻击 */
  ak2() {
    if (this.ak22 === 0) {
      this.b = 0
      this.qqblood -= this.ake
      prompt.showToast({
        message: "芙宁娜造成" + this.ake + "点伤害",
        duration: 500
      })

      this.ak22 += 2
      this.ak33 = Math.max(this.ak33 - 1, 0)
      setTimeout(() => this.processEnemyTurn(), 1500)
      this.visible = false
      if (this.qqblood <= 0) {
        router.replace({
          uri: "/pages/explore_goods"
        })
      }
    }
  },

  /* 进行Q攻击 */
  ak3() {
    if (this.ak33 === 0) {
      this.aka = this.aka * 1.25
      this.ake = this.ake * 1.25
      this.akq = this.akq * 1.25
      this.qqblood -= this.akq
      prompt.showToast({
        message: "增伤25%",
        duration: 1000
      })
      prompt.showToast({
        message: "芙宁娜造成" + this.akq + "点伤害",
        duration: 500
      })
      this.b = 0
      this.ak33 += 2
      setTimeout(() => this.processEnemyTurn(), 1500)
      this.visible = false
      if (this.qqblood <= 0) {
        router.replace({
          uri: "/pages/explore_goods"
        })
      }
    }
  },

  /* 游戏结束处理 */
  handleGameOver(uri) {
    router.replace({uri})
  },

  /* 初始化函数 */
  onInit() {
    Promise.all([
      this.getStorageValue("aka", 484),

      this.getStorageValue("ake", 936),
      this.getStorageValue("akq", 1358),
      this.getStorageValue("mxlv", 1),
      this.getStorageValue("j", 0),
      this.getStorageValue("blood", 1192)
    ]).then(([aka, ake, akq, mxlv, j, blood]) => {
      this.aka = aka
      this.ake = ake
      this.akq = akq
      this.mxlv = mxlv
      this.j = j
      this.blood = blood

      this.initializeStats()
    })
    if (this.diren === "骗骗花") {
      this.imgsrc = "/common/icon/flowerflower.png"
    } else if (this.diren === "野猪") {
      this.imgsrc = "/common/icon/pig.png"
    } else if (this.diren === "鸟") {
      this.imgsrc = "/common/icon/bird.png"
    }
  },

  /* 获取存储值 */
  getStorageValue(key, defaultValue) {
    return new Promise((resolve) => {
      storage.get({
        key,
        success: (result) => resolve(result ? parseInt(result, 10) : defaultValue)
      })
    })
  },

  initializeStats() {
    const levelRanges = [
      [10, [1, 10], [200, 250]],
      [20, [10, 20], [1000, 5040]],
      [30, [20, 30], [1554, 2513]],
      [40, [30, 40], [3913, 5532]],
      [50, [40, 50], [4832, 5551]],
      [60, [50, 60], [8750, 16600]],
      [70, [60, 70], [15000, 26750]],
      [80, [70, 80], [26250, 37800]],
