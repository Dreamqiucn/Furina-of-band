      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "丘丘暴徒"
        }
      })
    } else if (this.monster === 3) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "丘丘王"
        }
      })
    } else if (this.monster === 4) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "浮游水蕈兽"
        }
      })
    } else if (this.monster === 5) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "浮游草蕈兽"
        }
      })
    } else if (this.monster === 6) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "浮游风蕈兽"
        }
      })
    } else if (this.monster === 7) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "海乱鬼"
        }
      })
    } else if (this.monster === 8) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "丘丘岩盔王"
        }
      })
    } else if (this.monster === 9) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "无相之冰"
        }
      })
