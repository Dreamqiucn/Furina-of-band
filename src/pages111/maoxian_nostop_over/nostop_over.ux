<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

export default {
  public: {
    cake: 0,
    live: 0,
    jieduan: 1,
    mostjieduan: 1
  },

  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    storage.delete({
      key: "bff",
      success: () => {
        console.log("删除成功")
      }
    })
    storage.get({
      key: "jieduan",
      success: (resca) => {
        this.jieduan = resca ? parseInt(resca, 10) : 1
        storage.get({
          key: "mostjieduan",
          success: (resc) => {
            this.mostjieduan = resc ? parseInt(resc, 10) : 1
            if (this.jieduan > this.mostjieduan) {
              storage.set({
                key: "mostjieduan",
                value: this.jieduan.toString()
              })
              const keysToDelete = [
                "nstf",
                "nsjy",
                "nsalv",
                "nsqlv",
                "nselv",
                "nsaka",
                "nsake",
                "nsakq",
                "nsblood",
                "nslv",
                "jieduan"
              ] // 添加需要删除的键
              keysToDelete.forEach((key) => {
                storage.delete({
                  key: key
                })
              })
              return
            } else {
              const keysToDelete = [
                "nstf",
                "nsjy",
                "nsalv",
                "nsqlv",
                "nselv",
                "nsaka",
                "nsake",
                "nsakq",
                "nsblood",
                "nslv",
                "jieduan"
              ] // 添加需要删除的键
              keysToDelete.forEach((key) => {
                storage.delete({
                  key: key
                })
              })
              return
            }
          }
        })
      }
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index_maoxian_nostop"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index_maoxian_nostop"
    })
  }
}
</script>
