<template>
  <div class="page download-page" @swipe="toHomePage">
    <div class="header center">
      <text class="title">武器</text>
    </div>
    <list class="list1" bounces="true">
      <list-item class="item justify-between" type="costom" for="{{list}}" @click="navigateToPage($item.Src)">
        <div class="center">
          <image class="subject-image" src="{{$item.iconSrc}}"></image>
          <text class="subject-name">{{ $item.name }}</text>
        </div>
