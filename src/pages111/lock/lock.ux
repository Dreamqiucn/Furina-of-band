          "
        >
          {{ serial }}
        </text>
      </div>
      <div class="page2" style="height: 148px; top: 186px">
        <text class="fff-center" style="top: 9px; font-size: 22px">请记住设备码 点击下方教程</text>
        <text class="btn1" @click="to('qr')">如何获取密钥</text>
        <image style="position: absolute; top: 88px; left: 148px" src="/common/icon/to.png"></image>
      </div>
      <text
        class="font26"
        style="font-size: 20px; color: rgba(255, 255, 255, 0.6); top: 336px; left: 26px"
      >
        进行下一步操作
      </text>
      <image
