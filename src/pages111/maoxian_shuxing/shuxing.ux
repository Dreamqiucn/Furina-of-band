                                } else if (this.alv === 8) {
                                    this.aka = Math.round(1000 * 0.827); // LV8
                                    storage.set({ key: "aka", value: this.aka.toString() });
                                } else if (this.alv === 9) {
                                    this.aka = Math.round(1000 * 0.889); // LV9
                                    storage.set({ key: "aka", value: this.aka.toString() });
                                } else if (this.alv === 10) {
                                    this.aka = Math.round(1000 * 0.957); // LV10
                                    storage.set({ key: "aka", value: this.aka.toString() });
                                } else if (this.alv === 11) {
                                    this.aka = Math.round(1000 * 1.024); // LV11
                                    storage.set({ key: "aka", value: this.aka.toString() });
                                } else if (this.alv === 12) {
                                    this.aka = Math.round(1000 * 1.100); // LV12
                                    storage.set({ key: "aka", value: this.aka.toString() });
                                } else if (this.alv >= 13) {
                                    this.aka = Math.round(1000 * 1.213); // LV13
                                    storage.set({ key: "aka", value: this.aka.toString() });
                                }
                            }
                        });
                    }
                });
            }
        });
    }
},
