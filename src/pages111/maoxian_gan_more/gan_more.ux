<template>
  <div class="page download-page" @swipe="toHomePage">
    <scroll if="{{ which != '兑换无尽材料' }}" class="column box" scroll-y="true" bounces="true">
      <div class="header column center">
        <text class="b"></text>
      </div>
      <div class="header column center">
        <text class="b">{{ which }}</text>
        <text class="b">介绍</text>
      </div>
      <div class="description footer column center">
        <image class="icon" src="{{ img }}"></image>
        <text class="b">当前拥有： {{ currentCount }}</text>
        <text class="b">精炼等级：{{ jinglian }}/5</text>
        <input
          class="but column center"
          type="button"
          value="精炼"
          style="font-size: 30px; color: #ffffff"
          onclick="refineWeapon"
          if="{{ currentCount > 0 && jinglian < 5 }}"
        />
        <input
          class="but column center"
          type="button"
          value="装备"
          style="font-size: 30px; color: #ffffff"
          onclick="equipWeapon"
        />
        <text class="d">{{ whichtext }}</text>
        <text class="d">{{ whichmore }}</text>
      </div>
    </scroll>
    <scroll if="{{ which == '兑换无尽材料' }}" class="column box" scroll-y="true" bounces="true">
      <div class="header column center">
        <text class="b"></text>
      </div>
      <div class="header column center">
        <text class="e">当所有无尽材料精炼满后，可以兑换</text>
        <text class="e">1把4星=>500无尽经验天赋书</text>
        <text class="e">1把五星=>2000无尽经验天赋书</text>
        <div class="description footer column center">
          <text if="{{ allRefined }}">✓ 所有武器已精炼满级</text>
          <text if="{{ !allRefined }}">X 请先将所有武器精炼到5级</text>
        </div>
      </div>
      <div class="description footer column center">
        <text>当前无尽天赋书: {{ nstf }}</text>
        <text>当前无尽经验书: {{ nsjy }}</text>
        <input
          class="but column center"
          type="button"
          value="兑换多余武器"
          style="font-size: 30px; color: #ffffff"
          onclick="exchange"
        />
        <!-- <input
          class="but column center"
          type="button"
          value="设置测试数据"
          style="font-size: 30px; color: #ffffff"
          onclick="change1"
        /> -->
        <text class="d">{{ exchangeMessage }}</text>
      </div>
    </scroll>
  </div>
</template>

<style>
.back {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 72px;
  height: 72px;
  opacity: 0.7;
}

.but {
  width: 80%;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30px;
}

.description {
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 36px;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 10px;
  font-size: 14px;
  margin: 0 auto;
}

.icon {
  width: 75%;
  height: auto;
  max-height: 300px;
  max-width: 100%;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.center {
  align-items: center;
  justify-content: center;
}

.header {
  margin-top: 10px;
}

.page {
  padding: 10px;
  background-color: #000000;
  width: 192px;
  height: 480px;
}

.body {
  margin-top: 10px;
  margin-left: 15px;
}

.footer {
  margin-top: 10px;
}

.icon2 {
  width: 256px;
  flex: auto;
  margin-top: 10px;
  margin-left: 0px;
}

.a {
  font-size: 30px;
}

.b {
  font-size: 25px;
  color: #ffffff;
}

.c {
  font-size: 35px;
  color: #999999;
  margin-left: 20px;
}

.d {
  font-size: 20px;
  color: #d4d4d4;
  margin-top: 10px;
}

.e {
  font-size: 20px;
  color: #ffffff;
  margin-left: 10px;
}
