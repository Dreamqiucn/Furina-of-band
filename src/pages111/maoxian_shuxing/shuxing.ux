<script>
  // 导入模块
  import router from '@system.router'
import storage from "../../common/storage.js"
  import prompt from '@system.prompt'
  export default {
    public:{
      jys: 0,
      mxlv: 0,
      tfs: 0,
      elv: 0,
      qlv: 0,
      alv: 0,
      cake: 0,
    live: 0,
    see: false,
    aka: 0,
    ake: 0,
    akq: 0,
    blood: 0,
          upblood: 0,
    clickCount: 0,
    },deletedata() {
    this.clickCount += 1
    if (this.clickCount === 5) {
      const keysToDelete = [
        "mxlv",
        "alv",
        "qlv",
        "elv",
        "aka",
        "ake",
        "akq",
        "blood",
      ] // 添加需要删除的键
      keysToDelete.forEach((key) => {
        storage.delete({
          key: key
        })
      })
    } else if (this.clickCount === 4) {
      prompt.showToast({
        message: "再点击1次将会清除数据",
        duration: 1000
      })
    } else if (this.clickCount === 3) {
      prompt.showToast({
        message: "再点击2次将会清除数据",
        duration: 1000
      })
    } else if (this.clickCount === 2) {
      prompt.showToast({
        message: "再点击3次将会清除数据",
        duration: 1000
      })
    } else if (this.clickCount === 1) {
      prompt.showToast({
        message: "再点击4次将会清除数据",
        duration: 1000
      })
    }
  },
    lvup() {
    if (this.mxlv >= 90) {
        return;
    } else {
        storage.get({
            key: "jys",
            success: (resca) => {
                this.jys = resca ? parseInt(resca, 10) : 0;
                if (this.jys <= 0) {
                    return;
                }
                this.jys -= 1;
                storage.set({
                    key: "jys",
                    value: this.jys.toString()
                });
                storage.get({
                    key: "mxlv",
                    success: (resA) => {
                        this.mxlv = resA ? parseInt(resA, 10) : 0;
                        this.mxlv += 1;
                        storage.set({
                            key: "mxlv",
                            value: this.mxlv.toString(),
                            success: (a) => {
                                if (this.mxlv >= 1 && this.mxlv < 20) {
                                    this.blood = Math.round(((3091 - 1192) / 20) * this.mxlv + 1192);
                                    storage.set({ key: "blood", value: this.blood.toString() });
                                } else if (this.mxlv >= 20 && this.mxlv < 40) {
                                    this.blood = Math.round(((6154 - 3091) / 20) * (this.mxlv - 20) + 3091);
                                    storage.set({ key: "blood", value: this.blood.toString() });
                                } else if (this.mxlv >= 40 && this.mxlv < 50) {
                                    this.blood = Math.round(((8298 - 6154) / 10) * (this.mxlv - 40) + 6154);
                                    storage.set({ key: "blood", value: this.blood.toString() });
                                } else if (this.mxlv >= 50 && this.mxlv < 60) {
                                    this.blood = Math.round(((15042 - 8298) / 10) * (this.mxlv - 50) + 8298);
                                    storage.set({ key: "blood", value: this.blood.toString() });
                                } else if (this.mxlv >= 60 && this.mxlv < 70) {
                                    this.blood = Math.round(((21208 - 15042) / 10) * (this.mxlv - 60) + 15042);
                                    storage.set({ key: "blood", value: this.blood.toString() });
                                } else if (this.mxlv >= 70 && this.mxlv < 80) {
                                    this.blood = Math.round(((27098 - 21208) / 10) * (this.mxlv - 70) + 21208);
                                    storage.set({ key: "blood", value: this.blood.toString() });
                                } else if (this.mxlv >= 80 && this.mxlv <= 90) {
                                    this.blood = Math.round(((35704 - 27098) / 10) * (this.mxlv - 80) + 27098);
                                    storage.set({ key: "blood", value: this.blood.toString() });
                                }
                            }
                        });
                    }
                });
            }
        });
    }
},
eup() {
    if (this.elv >= 13) {
        return;
    } else {
       storage.get({
    key: "tfs",
    success: (resca) => {
        this.tfs = resca ? parseInt(resca, 10) : 0;
        
        // 检查 elv 的最大值并且控制 tfs 的减少
        if (this.mxlv < 10 && this.elv >= 2) {
            return; // 当 mxlv < 10 时，elv 最高为 2
        } else if (this.mxlv < 40 && this.elv >= 4) {
            return; // 当 mxlv < 40 时，elv 最高为 4
        } else if (this.mxlv < 60 && this.elv >= 6) {
            return; // 当 mxlv < 60 时，elv 最高为 6
        } else if (this.mxlv < 80 && this.elv >= 8) {
            return; // 当 mxlv < 80 时，elv 最高为 8
        }

        if (this.tfs <= 1) {
            return;
        }
        
        this.tfs -= 2;
        storage.set({
            key: "tfs",
            value: this.tfs.toString()
        });
        
        storage.get({
            key: "elv",
            success: (resB) => {
                this.elv = resB ? parseInt(resB, 10) : 0;
                
                if (this.mxlv < 10) {
                    this.elv = Math.min(this.elv + 1, 2); // elv最高为2
                } else if (this.mxlv < 40) {
                    this.elv = Math.min(this.elv + 1, 4); // elv最高为4
                } else if (this.mxlv < 60) {
                    this.elv = Math.min(this.elv + 1, 6); // elv最高为6
                } else if (this.mxlv < 80) {
                    this.elv = Math.min(this.elv + 1, 8); // elv最高为8
                } else {
                    this.elv += 1; // 大于等于80时不限制
                }
                storage.set({
                            key: "elv",
                            value: this.elv.toString(),
                            success: (a) => {
                                if (this.elv === 1) {
    this.ake = Math.round(this.blood * 10 * 0.0786);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 2) {
    this.ake = Math.round(this.blood * 10 * 0.0845);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 3) {
    this.ake = Math.round(this.blood * 10 * 0.0904);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 4) {
    this.ake = Math.round(this.blood * 10 * 0.0983);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 5) {
    this.ake = Math.round(this.blood * 10 * 0.1042);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 6) {
    this.ake = Math.round(this.blood * 10 * 0.1101);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 7) {
    this.ake = Math.round(this.blood * 10 * 0.118);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 8) {
    this.ake = Math.round(this.blood * 10 * 0.1258);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 9) {
    this.ake = Math.round(this.blood * 10 * 0.1337);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 10) {
    this.ake = Math.round(this.blood * 10 * 0.1416);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 11) {
    this.ake = Math.round(this.blood * 10 * 0.1494);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv === 12) {
    this.ake = Math.round(this.blood * 10 * 0.1573);
    storage.set({ key: "ake", value: this.ake.toString() });
} else if (this.elv >= 13) {
    this.ake = Math.round(this.blood * 10 * 0.162); // 适用于大于等于13的情况
    storage.set({ key: "ake", value: this.ake.toString() });
}this.upblood = Math.round(this.ake/5)

                            }
                        });
            }
        });
    }
});
    }
},
aup() {
    if (this.alv >= 13) {
        return;
    } else {
        storage.get({
