      [4060, [4020, 4060], [446800000000, 510300000000]],
      [4100, [4060, 4100], [510300000000, 582900000000]],
      [4140, [4100, 4140], [582900000000, 665900000000]],
      [4180, [4140, 4180], [665900000000, 760700000000]],
      [4220, [4180, 4220], [760700000000, 869000000000]],
      [4260, [4220, 4260], [869000000000, 992600000000]],
      [4300, [4260, 4300], [992600000000, 1134000000000]],
      [4340, [4300, 4340], [1134000000000, 1295000000000]],
      [4380, [4340, 4380], [1295000000000, 1479000000000]],
      [4420, [4380, 4420], [1479000000000, 1689000000000]],
      [4460, [4420, 4460], [1689000000000, 1929000000000]],
      [4500, [4460, 4500], [1929000000000, 2203000000000]],
      [4540, [4500, 4540], [2203000000000, 2516000000000]],
      [4580, [4540, 4580], [2516000000000, 2874000000000]],
      [5000, [4500, 5000], [3000000000000, 3500000000000]],
      [5500, [4500, 15000], [3500000000000, 4000000000000]],
      [6000, [4500, 15000], [4000000000000, 4500000000000]],
      [6500, [4500, 15000], [4500000000000, 5000000000000]],
      [7000, [4500, 15000], [5000000000000, 5500000000000]],
      [7500, [4500, 15000], [5500000000000, 6000000000000]],
      [8000, [4500, 15000], [6000000000000, 6500000000000]],
      [8500, [4500, 15000], [6500000000000, 7000000000000]],
      [9000, [4500, 15000], [7000000000000, 7500000000000]],
      [9500, [4500, 15000], [7500000000000, 8000000000000]],
      [10000, [4500, 15000], [8000000000000, 8500000000000]],
      [10500, [4500, 15000], [8500000000000, 9000000000000]],
      [11000, [4500, 15000], [9000000000000, 9500000000000]],
      [11500, [4500, 15000], [9500000000000, 10000000000000]],
      [12000, [4500, 15000], [10000000000000, 10500000000000]],
      [12500, [4500, 15000], [10500000000000, 11000000000000]],
      [13000, [4500, 115000], [11000000000000, 11500000000000]],
      [13500, [4500, 115000], [11500000000000, 12000000000000]],
      [14000, [4500, 115000], [12000000000000, 12500000000000]],
      [14500, [4500, 115000], [12500000000000, 13000000000000]],
      [15000, [4500, 115000], [13000000000000, 13500000000000]],
      [20000, [4500, 1115000], [135000000000000, 500000000000000]],
      [30000, [4500, 1115000], [135000000000000, 500000000000000]],
      [40000, [4500, 1115000], [135000000000000, 500000000000000]],
      [50000, [4500, 1115000], [135000000000000, 500000000000000]],
      [60000, [4500, 1115000], [135000000000000, 500000000000000]],
      [70000, [4500, 1115000], [135000000000000, 500000000000000]],
      [100000000000, [4500, 11115000], [500000000000000, 1050000000000000]]
    ]

    if (this.mxlv > 0) {
      for (let i = 0; i < levelRanges.length; i++) {
        const [upLimit, qqlvRange, qqbloodRange] = levelRanges[i]
        if (this.mxlv <= upLimit) {
          this.qqlv = this.getRandomInt(qqlvRange[0], qqlvRange[1])
          this.qqblood = this.getRandomInt(qqbloodRange[0], qqbloodRange[1])
          break
        }
      }
    }
  },

  getRandomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min
  },

  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index_explore"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index_explore"
    })
  }
}
</script>
