        break
      case 13:
        prompt.showToast({
          message: "芙芙今天想读书，于是去看了《转生之我成为雷电将军然后天下无敌》",
          duration: 2000
        })
        setTimeout(() => {
          router.push({
            uri: "/pages/photo_all",
            params: {
              which: "轻小说"
            }
          })
        }, 2000)
        break
      case 14:
        storage.get({
          key: "j",
          success: (result) => (this.j = result ? parseInt(result, 10) : 0)
        })
        this.j += 2
        storage.set({
          key: "j",
          value: this.j.toString()
        })
        prompt.showToast({
          message: "芙芙今天想吃点东西，甜甜花酿鸡数量加2",
          duration: 2000
        })
        break
      case 15:
        // 这里不需要获取任何数据，因为只是显示提示信息
        prompt.showToast({
          message: "芙芙提醒你老师来了，别玩手环了",
          duration: 2000
        })
        break
      case 16:
        // 这里不需要获取任何数据，因为是页面跳转
        storage.get({
          key: "food",
          success: (result) => (this.food = result ? parseInt(result, 10) : 0)
        })
        this.food += 2
        storage.set({
          key: "food",
          value: this.food.toString()
        })
        prompt.showToast({
          message: "芙芙想去野外玩玩，探索点东西了",
          duration: 2000
        })
        setTimeout(() => {
          router.replace({
            uri: "/pages/index_explore"
          })
        }, 2000)
        break
      case 17:
        // 这里不需要获取任何数据，因为是页面跳转
        prompt.showToast({
          message: "芙芙感觉有点热，去找无相之冰了",
          duration: 2000
        })
        setTimeout(() => {
          router.push({
            uri: "/pages/maoxian_putong",
            params: {
              which: "无相之冰"
            }
          })
        }, 2000)
        break
      case 18:
        storage.get({
          key: "cake",
          success: (result) => (this.cake = result ? parseInt(result, 10) : 0)
        })
        this.cake = 0
        storage.set({
          key: "cake",
          value: this.cake.toString()
        })
        prompt.showToast({
          message: "芙芙把小蛋糕全吃了，因为不是你给她的，所以没有加好感度",
          duration: 2000
        })
        break
      case 19:
        storage.get({
          key: "jieduan",
          success: (result) => (this.jieduan = result ? parseInt(result, 10) : 0)
        })
        this.jieduan += 5
        storage.set({
          key: "jieduan",
          value: this.jieduan.toString()
        })
        prompt.showToast({
          message: "芙芙趁你不注意，自己给无尽模式打了好几关",
          duration: 2000
        })
        break
      case 20:
        // 这里不需要获取任何数据，因为是页面跳转
        prompt.showToast({
          message: "芙芙有点渴，于是去找纯水精灵了",
          duration: 2000
        })
        setTimeout(() => {
          router.push({
            uri: "/pages/maoxian_putong",
            params: {
              which: "纯水精灵"
            }
          })
        }, 2000)
        break
      case 21:
        // 这里不需要获取任何数据，因为是页面跳转
        prompt.showToast({
          message: "芙芙觉得小螃蟹很可爱，于是去找了它",
          duration: 2000
        })
        setTimeout(() => {
          router.push({
            uri: "/pages/maoxian_putong",
            params: {
              which: "原海异种"
            }
          })
        }, 2000)
        break
      case 22:
        // 这里不需要获取任何数据，因为是页面跳转
        prompt.showToast({
          message: "芙芙想祈愿了",
          duration: 2000
        })
        setTimeout(() => {
          router.replace({
            uri: "/pages/ball_three"
          })
        }, 2000)
        break
      case 23:
        const today = new Date()
        const adjustedA = today.getDay() === 0 ? 7 : today.getDay() // 将星期数转换为1-7的格式

        if (adjustedA === 7 || adjustedA === 6) {
          storage.get({
            key: "goaway",
            success: (result) => (this.goaway = result ? parseInt(result, 10) : 0)
          })
          storage.set({
            key: "goaway",
            value: "1"
          })
          storage.get({
            key: "stone",
            success: (a) => {
              this.stone = a ? parseInt(a, 10) : 0
              this.stone += 1600
              storage.set({
                key: "stone",
                value: this.stone.toString()
              })
            }
          })
          prompt.showToast({
            message: "彩蛋：今天是周末，芙芙去逛街了，把你丢下了，她说明天回来,会给你带礼物",
            duration: 2000
          })
          setTimeout(() => {
            router.replace({
              uri: "/pages/index"
            })
          }, 2000)
        } else {
          prompt.showToast({
            message: "芙芙说AI写的剧情太泔水了，你让看看她的官方剧情",
            duration: 2000
          })
          setTimeout(() => {
            router.replace({
              uri: "/pages/index_gfjq"
            })
          }, 2000)
        }
        break
      case 24:
        // 这里不需要获取任何数据，因为只是显示提示信息
        prompt.showToast({
          message: "芙芙觉得你的名字不是很好听，让你改个名字",
          duration: 2000
        })
        setTimeout(() => {
          router.replace({
            uri: "/pages/index_name"
          })
        }, 2000)
        break
      case 25:
        // 这里不需要获取任何数据，因为只是显示提示信息
        prompt.showToast({
          message: "芙芙想让你更了解她，她让你好好阅读一下她的Wiki",
          duration: 2000
        })
        setTimeout(() => {
          router.replace({
            uri: "/pages/wiki"
          })
        }, 2000)
        break
      case 26:
        // 这里不需要获取任何数据，因为只是显示提示信息
        prompt.showToast({
          message: "芙芙想让你看看她的相册",
          duration: 2000
        })
        setTimeout(() => {
          router.replace({
            uri: "/pages/index_photo"
          })
        }, 2000)
        break
      case 27:
        // 这里不需要获取任何数据，因为只是显示提示信息
        prompt.showToast({
          message: "芙芙说突发事件有一个彩蛋,只有有点时候可以触发，不知道你遇到没遇到",
          duration: 2000
        })

        break
      case 28:
        // 这里不需要获取任何数据，因为是页面跳转
        prompt.showToast({
          message: "芙芙感觉是不是少了点突破材料，于是去打吞星之鲸了",
          duration: 2000
        })
        setTimeout(() => {
          router.push({
            uri: "/pages/maoxian_putong",
            params: {
              which: "吞星之鲸"
            }
          })
        }, 2000)
        break
    }
  },
  handleButtonClick() {
    if (this.numberthing <= 0) {
      return
    }
    this.decreaseA()
    this.redirectToRandomPage()
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index"
    })
  }
}
</script>
