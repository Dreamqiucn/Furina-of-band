      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "丘丘岩盔王"
            }
          })
      }, 1000)
    } else if (this.monster === 9) {
      this.realmonster = "无相之冰"
      this.remind = "“冻住了怎么办？”"
      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "无相之冰"
            }
          })
      }, 1000)
    } else if (this.monster === 10) {
      this.realmonster = "原海异种"
      this.remind = "“好可爱为什么要打它？”"
      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "原海异种"
            }
          })
      }, 1000)
    } else if (this.monster === 11) {
      this.realmonster = "纯水精灵"
      this.remind = "“水打水似乎有点麻烦”"
      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "纯水精灵"
            }
          })
      }, 1000)
    } else if (this.monster === 12) {
      this.realmonster = "吞星之鲸"
      this.remind = "“别叫外援！”"
      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "吞星之鲸"
            }
          })
      }, 1000)
    }
  },
  gonow() {
    if (this.monster === 1) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "丘丘人"
        }
      })
