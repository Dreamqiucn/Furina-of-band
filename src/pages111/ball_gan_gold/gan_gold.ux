<template>
  <div class="page download-page">
    <div if="{{ first == false }}" class="header column center">
      <text>结果</text>
      <text class="b">{{ itemName }}</text>
      <text class="b">获得物品：1</text>
    </div>

    <div if="{{ first == false }}" class="center column">
      <image class="icon2" src="/common/icon/zhuanwu.png"></image>
      <text class="b">当前拥有：x {{ currentCount }}</text>
    </div>

    <image
      class="back"
      if="{{ first == false }}"
      src="/common/icon/back.png"
      onclick="back"
    ></image>
    <image class="bg" if="{{ first }}" src="{{ bg }}" onclick="bgg"></image>
  </div>
</template>
<style>
.back {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
  z-index: 1000;
}

.b {
  font-size: 25px;
}

.icon {
  width: 60px;
  height: 60px;
}

.item {
  display: flex;
  justify-content: flex-end;
  /* 向右对齐 */
  align-items: center;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.center {
  align-items: center;
  justify-content: center;
}

.header {
  margin-top: 20px;
}

.page {
  background-color: #000000;
  width: 192px;
  height: 480px;
}

.icon2 {
  width: 128px;
  height: 128px;
}
</style>

<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"

// 武器配置映射表
const WEAPON_MAP = {
  jlj: {
    name: "祭礼剑",
    icon: "jlj.png"
  },
  huihe: {
    name: "灰河渡手",
    icon: "huihe.png"
  },
  shuixian: {
    name: "水仙十字剑",
    icon: "shuixian.png"
  },
  changjian: {
    name: "船坞长剑",
    icon: "changjian.png"
  },
  zhuanwu: {
    name: "静水流涌之辉",
    icon: "/common/icon/zhuanwu.png"
  }
}

export default {
  public: {
    star: 0,
    first: true,
    bg: "/common/icon/zi.png",
    goods: "/common/icon/cake.png",
    itemName: "物品名称",
    currentCount: 0 // 新增当前数量显示
  },
  bgg() {
    this.first = false
  },
  // 修改后的库存更新方法
  updateInventory(itemKey) {
    storage.get({
      key: "inventory",
      success: (data) => {
        // 初始化库存结构
        const DEFAULT_INVENTORY = {
          jlj: 0,
          huihe: 0,
          shuixian: 0,
          changjian: 0,
          zhuanwu: 0
        }

        // 解析库存数据
        let inventory = data ? JSON.parse(data) : {...DEFAULT_INVENTORY}
        const oldCount = inventory[itemKey] || 0

        // 显示获取前的数量（示例输出）
        console.log(`增加前数量：${oldCount}`)

        // 更新数量
        inventory[itemKey] = oldCount + 1
        this.currentCount = inventory[itemKey] // 更新显示数量

        // 保存数据
        storage.set({
          key: "inventory",
          value: JSON.stringify(inventory)
        })
      }
    })
  },

  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    storage.set({
      key: "wx",
      value: "0"
    })
    this.bg = "/common/icon/gold.png"
    const weapons = ["jlj", "huihe", "shuixian", "changjian", "zhuanwu"]
    const itemKey = weapons[4]
    this.goods = `/common/icon/${WEAPON_MAP[itemKey].icon}`
    this.itemName = WEAPON_MAP[itemKey].name
    this.updateInventory(itemKey)
  },

  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index_ball_pink"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index_ball_pink"
    })
  }
}
</script>
