                <div class="center column"><text class="b">LV:{{qlv}}</text>
                    <text class="b"> 伤害:{{akq}}</text>
                </div>
                <input class="but" type="button" value="升级" style="font-size: 25px;color: #ffffff;" onclick="qup"></input>
            </div>
            <input class="but" if="{{see}}" type="button" value="复活" style="font-size: 25px; color: #ffffff"
                onclick="eatCake" />
            <input class="but111" type="button" value="卡住清除数据按钮" style="font-size: 20px; color: #ffffff"
                onclick="deletedata" />

        </div>



    </div>
</template>

  <style>
  .but111 {
      width: 192px;

      background-color: rgba(255, 255, 255, 0.2);
      border-radius: 30px;
  }

  .back {
      position: absolute;
      left: 6px;
      top: 6px;
      width: 72px;
      height: 72px;
      opacity: 1;
      z-index: 1000;
  }

  .but1 {
      width: 45px;

      background-color: rgba(255, 255, 255, 0.2);
      border-radius: 30px;
  }

  .but {
      width: 45px;

      background-color: rgba(255, 255, 255, 0.2);
