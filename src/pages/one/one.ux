<template>
  <div class="page download-page" @swipe="toHomePage">
    <div class="header column center">
      <text>结果</text>
      <text class="b">普茹斯蒂司 {{cake}} 个</text>
    </div>
    
      <div class="info center row" >
          <image class = "icon2" src="/common/icon/cake.png" >
          <div class="column item">
              <text class="b">普茹斯蒂司</text>
              <text class="b">x 1</text>
          </div>
          
      </div>
      <div class="info center row">
          <image class = "icon2"src="/common/icon/uncake.png">
          <div class="column item">
             <text class="b">致水神</text>
             <text class="b">x 9</text>
          </div>
          
      </div>
  </div>
      
      
 
</template>

  <style>
  .back {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 72px;
    height: 72px;
    opacity: 1;
    z-index: 1000;
  }

  .b {
    font-size: 25px;
  }

  .icon {
    width: 60px;
    height: 60px;
  }

  .item {
    display: flex;
    justify-content: flex-end;
    /* 向右对齐 */
    align-items: center;
  }



  .download-page {
    display: flex;
    flex-direction: column;

    height: 100%;
    position: absolute;
    width: 100%;
  }

  text {
    color: #ffffff;
  }

  .column {
    /* 竖直 */
    flex-direction: column;
  }

  .row {
    /* 水平 */
    flex-direction: row;
  }

  .center {
    align-items: center;
    justify-content: center;
  }

  .header {
    margin-top: 20px;
  }

  .page {

    background-color: #000000;
    width: 192px;
    height: 480px;
  }

  .icon2 {
    width: 100px;
    height: 100px;
  }
</style>


<script>
  // 导入模块
  import router from '@system.router'
 import storage from '@system.storage'
  export default {
    public: {
      cake: 0,
    },
    onInit() {
      storage.get({
            key: "cake",
            success: (resca) => {
              this.cake = resca ? parseInt(resca, 10) : 0
              this.cake += 1
              storage.set({
                key: "cake",
                value: this.cake.toString()
              })
            }
        })
    },
    toHomePage(eve) {
      if (eve.direction === 'right') {
        router.replace({
        uri: '/pages/ball'
        })
    }
    
    }
  }
</script>