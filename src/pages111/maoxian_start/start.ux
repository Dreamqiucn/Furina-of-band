              which: "浮游风蕈兽"
            }
          })
      }, 1000)
    } else if (this.monster === 7) {
      this.realmonster = "海乱鬼"
      this.remind = "“很好的芙芙，爱来自稻妻”"
      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "海乱鬼"
            }
          })
      }, 1000)
    } else if (this.monster === 8) {
      this.realmonster = "丘丘岩盔王"
