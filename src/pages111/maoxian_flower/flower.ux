      [290, [280, 290], [361000, 375500]],
      [300, [290, 300], [375500, 390000]],
      [310, [300, 310], [390000, 404500]],
      [320, [310, 320], [404500, 419000]],
      [330, [320, 330], [419000, 433500]],
      [340, [330, 340], [433500, 448000]],
      [380, [340, 380], [448000, 600000]],
      [420, [380, 420], [600000, 800000]],
      [460, [420, 460], [800000, 1100000]],
      [500, [460, 500], [1100000, 1500000]],
      [540, [500, 540], [1500000, 2000000]],
      [580, [540, 580], [2000000, 2600000]],
      [620, [580, 620], [2600000, 3300000]],
