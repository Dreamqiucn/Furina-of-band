  async onInit() {
    console.log("which" + this.which)
    if (this.which === "丘丘人") {
      this.img = "/common/icon/qqr.png"
      this.pic = true
    } else if (this.which === "丘丘暴徒") {
      this.img = "/common/icon/qqbt.png"
      this.pic = true
    } else if (this.which === "丘丘王") {
      this.img = "/common/icon/qqw.png"
      this.pic = true
    } else if (this.which === "丘丘岩盔王") {
      this.img = "/common/icon/realqqw.png"
      this.pic = false
    } else if (this.which === "浮游草蕈兽") {
      this.img = "/common/icon/cao.png"
    } else if (this.which === "浮游风蕈兽") {
      this.img = "/common/icon/feng.png"
    } else if (this.which === "浮游水蕈兽") {
      this.img = "/common/icon/shui.png"
    } else if (this.which === "纯水精灵") {
      this.img = "/common/icon/waterren.png"
      this.pic = false
    } else if (this.which === "无相之冰") {
      this.img = "/common/icon/wuxiangbing.png"
      this.pic = false
    } else if (this.which === "海乱鬼") {
      this.img = "/common/icon/hailuan.png"
      this.pic = false
    } else if (this.which === "原海异种") {
      this.img = "/common/icon/pangxie.png"
    } else if (this.which === "吞星之鲸") {
      this.img = "/common/icon/jing.png"
      this.pic = false
    }

    Promise.all([
      this.getStorageValue("nsaka", 250),
      this.getStorageValue("nsake", 350),
      this.getStorageValue("nsakq", 550),
      this.getStorageValue("mxlv", 1),
      this.getStorageValue("j", 0),
      this.getStorageValue("nsblood", 1250),
      this.getStorageValue("jieduan", 0)
    ]).then(([nsaka, nsake, nsakq, mxlv, j, nsblood, jieduan]) => {
      this.nsaka = nsaka
      this.nsake = nsake
      this.nsakq = nsakq
      this.mxlv = mxlv
      this.j = j
      this.nsblood = nsblood
      this.jieduan = jieduan
      this.initializeStats()
    })
    this.validateNumbers()
    const valuesToCheck = [
      this.nsaka,
      this.nsake,
      this.nsakq,
      this.mxlv,
      this.j,
      this.nsblood,
      this.jieduan
    ]
    if (valuesToCheck.some((v) => Number.isNaN(v))) {
      console.log("has nan")
      prompt.showToast({
        message: "数据加载异常，请重新启动游戏或重启手环",
        duration: 3000
      })
      setTimeout(() => {
        router.replace({uri: "/pages/index"})
      }, 3000)
    } else {
      storage.get({
        key: "currentWeapon",
        success: (res) => {
          this.currentWeapon = res
          if (this.currentWeapon === "changjian") {
            this.currentWeaponName = "船坞长剑"
          } else if (this.currentWeapon === "huihe") {
            this.currentWeaponName = "灰河渡手"
          } else if (this.currentWeapon === "jlj") {
            this.currentWeaponName = "祭礼剑"
          } else if (this.currentWeapon === "shuixian") {
            this.currentWeaponName = "水仙十字剑"
          } else if (this.currentWeapon === "zhuanwu") {
            this.currentWeaponName = "静水流涌之辉"
          }
          prompt.showToast({
            message: `当前武器：${this.currentWeaponName}`,
            duration: 1000
          })
        },
        fail: (err) => {
          console.log(err)
        }
      })
      this.refinementLevel = await this.getRefinementLevel()
      this.healthBonus = CHANGJIAN_BONUS.health[this.refinementLevel - 1] * 100 || 0
      this.skillBonus = (CHANGJIAN_BONUS.skill[this.refinementLevel - 1] - 1) * 100 || 0
      const baseBlood = await this.getStorageValue("nsblood", 1250)
      const baseAk1 = await this.getStorageValue("nsaka", 250)
      const baseAk2 = await this.getStorageValue("nsake", 350)
      const baseAk3 = await this.getStorageValue("nsakq", 550)
      if (this.currentWeapon === "changjian" && this.refinementLevel > 0) {
        const bonusMultiplier = 1 + CHANGJIAN_BONUS.health[this.refinementLevel - 1] || 1
        this.nsblood = Math.round(baseBlood * bonusMultiplier)
      } else if (this.currentWeapon === "changjian" && this.refinementLevel === 0) {
        this.nsblood = Math.round(baseBlood * 1.1)
      } else if (this.currentWeapon === "huihe" && this.refinementLevel > 0) {
        const bonusMultiplier = HUIHE_BONUS.health[this.refinementLevel - 1] || 1
        this.nsaka = Math.round(baseAk1 * bonusMultiplier)
        this.nsake = Math.round(baseAk2 * bonusMultiplier)
        this.nsakq = Math.round(baseAk3 * bonusMultiplier)
      } else if (this.currentWeapon === "huihe" && this.refinementLevel === 0) {
        this.nsaka = Math.round(baseAk1 * 1.1)
        this.nsake = Math.round(baseAk2 * 1.1)
        this.nsakq = Math.round(baseAk3 * 1.1)
      } else if (this.currentWeapon === "jlj" && this.refinementLevel > 0) {
        this.gailv = JLJ_BONUS.health[this.refinementLevel - 1] || 1
      } else if (this.currentWeapon === "jlj" && this.refinementLevel === 0) {
        this.gailv = 0.1
      } else if (this.currentWeapon === "shuixian" && this.refinementLevel > 0) {
        this.shuixiana = SHUIXIAN_BONUS.health[this.refinementLevel - 1] || 1
      } else if (this.currentWeapon === "jlj" && this.refinementLevel === 0) {
        this.shuixiana = 1.2
      } else if (this.currentWeapon === "zhuanwu" && this.refinementLevel > 0) {
        const zhuanwuUP = 1 + CHANGJIAN_BONUS.health[this.refinementLevel - 1] || 1
        this.zhuanwubloodup = ZHUANWU_BONUS.health[this.refinementLevel - 1] || 1
        this.nsaka = Math.round(baseAk1 * zhuanwuUP)
        this.nsake = Math.round(baseAk2 * zhuanwuUP)
        this.nsakq = Math.round(baseAk3 * zhuanwuUP)
        this.nsblood = Math.round(baseBlood * zhuanwuUP)
      } else if (this.currentWeapon === "zhuanwu" && this.refinementLevel === 0) {
        this.zhuanwubloodup = 0.1
        this.nsaka = Math.round(baseAk1 * 1.1)
        this.nsake = Math.round(baseAk2 * 1.1)
        this.nsakq = Math.round(baseAk3 * 1.1)
        this.nsblood = Math.round(baseBlood * 1.1)
      } else {
        console.log("无武器")
        console.log("武器效果" + this.currentWeapon)
        console.log("装备等级" + this.refinementLevel)
      }
      this.realblood = this.nsblood
      console.log("realblood" + this.realblood)
    }
    this.visible = true
    console.log("visible" + this.visible)
  },
  async getRefinementLevel() {
    return new Promise((resolve) => {
      storage.get({
        key: "refinement",
        success: (data) => {
          const refinement = data ? JSON.parse(data) : {}
          resolve(refinement[this.currentWeapon] || 0)
        }
      })
    })
  },
  getStorageValue(key, defaultValue) {
    return new Promise((resolve) => {
      storage.get({
        key,
        success: (result) => resolve(result ? parseInt(result, 10) : defaultValue)
      })
    })
  },

