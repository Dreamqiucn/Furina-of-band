    } else if (this.which === "第十四章") {
      this.texts = [
        "芙芙，准备好了吗？我们今天的旅程可是特别精彩！我兴奋地叫道。",
        "等一下！我还没整理好呢！芙芙稍显慌乱，脸上带着一丝红晕，急匆匆地在帐篷里翻找。",
        "好吧，放轻松，我等你。我笑着说道，望着她忙碌的样子，心中暗想她真可爱。",
        "哼！才不是为了你才急着整理的！我只是想确保自己看起来好看而已。芙芙不满地撅嘴",
        "当然，芙芙总是好看的，水神嘛，永远闪闪发光！我故作认真地回应，努力让她心情愉快。",
        "你这家夥——她微微顿了顿，之后又抬起头，眼中透出一丝得意， 好吧，就是这样！那么，我们要去哪儿呢？",
        "我想先去璃月，那里有很多美食和美景，我们能好好享受一番。我提议道。",
        "那就决定了，准备出发吧！我俯下身来，准备好背包。",
        "我们出发！芙芙兴奋地喊道，整个人显得活泼而灵动。",
        "一路上，微风伴随着我们的脚步，目的地在前方的山峦和云雾中显现。我和芙芙一路聊天，互相分享彼此的期待。",
        "你说，我们到璃月的时候，可以去吃什么？我问道，想要让她放松心情。",
        "当然是吃、吃……糖葫芦！她的脸瞬间红了，语气中又带着一丝傲娇，我可是水神，被那种甜食吸引是正常的！",
        "哈哈，没问题，今天就为你准备十串！我打趣道。",
        "十串！？你觉得我……我能吃得完吗？她有些惊讶，瞬间结巴。",
        "当然能！你可是水神，吃得下的！我鼓励道，收拾好自己的行李，朝前迈去。",
        "唔……才、才不是为了吃才出门的！她轻声辩解，但语气里满是开心。",
        "终于，我们抵达了璃月港。五彩斑斓的市场和热闹的人群让芙芙惊叹不已，原本的紧张似乎被兴奋所替代。",
        "看！那边有糖葫芦摊！芙芙指向前方，眼中闪烁着光芒。",
        "走吧，我们去看看！我拉着她的手，向摊位奔去。",
        "谢谢！我、我想要十串糖葫芦！芙芙自信地对摊主说，声音中再无怯懦。",
        "真的是十串吗？我扬眉调侃，她却用力点了点头，显得异常坚定。",
        "伴随着暄闹的市场声和欢声笑语，我和芙芙的心情愈加欢快。彼此之间的默契和信任在这次旅程中变得愈加深厚。",
        "今天真是太棒了，和你一起出门真好。我由衷地感叹。",
        "哼，当然，我可是特意为你排除万难才出门的。芙芙微微傲娇，但脸上绽放出的笑容却暴露了她的开心。",
        "那么，接下来我们去哪儿？我问她。",
        "我想去看看那些山峦……她的声音轻柔而坚定，我们可以一起攀登的。",
        "当然，芙芙，我会陪着你一起征服更高的山。我说着，将手握紧，心中充满期待。"
      ]
    } else if (this.which === "第十五章") {
      this.texts = [
        "在璃月港的热闹中，我们终于得到了十串美味的糖葫芦。芙芙接过糖葫芦，脸上洋溢着灿烂的笑容。",
        "看，我说我能吃得下吧！她开心地摇晃着手中的糖葫芦，仿佛在向我炫耀。",
        "没错！水神的胃口果然不一般！我打趣道，目不转睛地观察她的反应。看着她欢蹦跳跳的模样，心中不禁感到温暖。",
        "我们找个地方坐下来吃吧。我提议。",
        "好！芙芙点头，拉着我走向附近的小广场，那里有几张木桌，上面装饰着五光十色的花朵。我们在一张桌子旁坐下，阳光洒在我们的身上，四周散发着淡淡的花香。",
        "来，给你！她兴奋地把一串糖葫芦递给我，眼中闪烁着期待。",
        "谢谢你，芙芙。我笑着接过，轻轻咬了一口，甜美的味道令我愉悦。",
        "味道怎么样？她迫不及待地问，眼中满是期待。",
        "好极了！就像你一样甜！我故作认真地说。芙芙的脸瞬间红了，面露羞涩。",
        "你这家夥，才、才不是这样呢！她用力撅嘴，强迫自己转开脸，却又忍不住偷偷往我这边瞄。",
        "哈哈，真可爱。我忍不住笑出声来，抓住她的手，一起分享这份美味。",
        "那个……我们一会儿再去别的地方吧！芙芙有些犹豫，瞅着四周的热闹，显得有些小紧张。",
        "当然可以，随你决定！我肯定地点头，感到她的心情逐渐变好。",
        "呃，听说璃月的博物馆里有很多珍贵的历史文物，我们可以去看看！她的声音逐渐坚定，眼中闪过一丝兴奋。",
        "太好了！走吧，水神的选择一定不会错！我激动地点头，和她一起朝博物馆走去。",
        "走进博物馆，我被丰富的展览吸引住了。各式各样的文物、精美的艺术品在灯光下熠熠生辉。芙芙在一旁仔细观看，脸上闪烁着好奇的光芒。",
        "看，那是古老的岩器！真漂亮！我指着展品兴奋地说道。",
        "好好好！不过，我更喜欢那边的水晶！她瞬间兴奋，拉着我走向展厅的一角。",
        "在水晶的光芒下，芙芙犹如一朵盛开的花，眼中满是对美的渴望和欣赏。在这一刻，她忘却了所有的紧张，尽情沉浸在这光辉的世界中。",
        "芙芙，你喜欢水晶吗？我轻声问道，心中暗想，她真是个特别的存在。",
        "当然，这是我与水元素最亲近的联系。她微微一笑，眼中闪烁着自信与傲娇，作为水神，我当然要有足够的审美！",
        "在她的激烈讨论中，我感受到了她内心深处的热情。随后，我们还欣赏了各式各样的展品，时间在我们的欢声笑语中悄然流逝。",
        "真是有趣的一天，和你在一起的时间总是过得特别快。我感叹道，心里充满了满足感。",
        "哼，当然，我的陪伴可不是随便就能遇到的！芙芙傲娇地回应，眼中满是自信。",
        "所以，接下来我们去哪里呢？我问。",
        "我听说在璃月的高地上有个特别的景点，能俯瞰整个璃月，晚上还能看到夜空中璀璨的星星！她的眼中闪烁着期待的光芒。",
        "太好了，我们就去那里吧！我立刻决定，立即带着她朝高地出发。",
        "在路上，我们欣赏着四周的风景，沿途的花草树木让我们心情愉悦。随着逐渐接近高地，那清新的空气和宁静的环境让我们倍感舒适。",
        "终于，我们到达了高地，眼前的景色令我们惊叹不已。辽阔的璃月港如同璀璨的宝石，阳光照耀下的海面波光粼粼，美得令人窒息。",
        "这、这个地方真漂亮！芙芙激动地大喊，脸上满是兴奋。",
        "是啊，真的太美了！我点头，感受着这份宁静和美丽。",
        "随着晚上降临，璀璨的星空将整个璃月装点得如梦似幻。芙芙静静地坐在我身旁，仰望着夜空中的繁星，脸上的表情温柔而宁静。",
        "如果能永久留在这美好的时光就好了。她轻声说道，语气中透着一丝渴望。",
        "我们一定会再回来这里的，芙芙。我坚定地回答，握住她的手，心中满是信心。",
        "嗯……和你在一起我觉得很安全，真的挺开心的。她的声音低了下来，脸颊微红。",
        "那就让我们继续一起冒险，去探索更多的国家吧！我提议，眼中闪烁着梦想的光芒。",
        "当然，有你陪着我，我就无所畏惧！芙芙的眼中重新焕发出自信，仿佛水中的光芒一般明亮。"
      ]
    } else if (this.which === "第十六章") {
      this.texts = [
        "我: “喂，芙芙，今天的天气真好，准备好要出发了吗？”",
        "芙宁娜: “嗯嗯！听说稻妻的美食很有特色，我超级期待！”",
        "我们搭乘一艘小船，沿着波光粼粼的海面驶向远方。大海的微风轻轻拂过，芙宁娜的长发随风飘舞，愈发显得动人。",
        "我: “快看，前面就是稻妻的山脉了！”",
        "芙宁娜: “好美！那山看起来像一幅画！”她的眼中闪烁着兴奋的光彩。",
        "随着船只靠近稻妻，远处的神社和樱花树映入我们的眼帘，稻妻的独特魅力让我们陶醉。",
        "上岸后，我们首先来到了一个热闹的市集，五彩缤纷的摊位上满是各式各样的商品。",
        "我: “这里的特产真多！我们可以试试那些小吃吗？”",
        "芙宁娜: “当然！我想吃‘鱼饼’和‘抹茶冰淇淋’！”",
        "我们兴奋地逛着市集，尝试了稻妻许多美食。吃着鲜美的鱼饼，芙宁娜的脸上露出了满足的笑容。",
        "我: “真好吃吧！”",
        "芙宁娜: “太好吃了！这根本不比璃月的美食差！”她一边吃一边开心地说着。",
        "逛完市集后，我们决定去参观有名的神社。走在铺满樱花的路径上，芙宁娜一边欣赏着花瓣纷飞的美景，一边轻声赞叹。",
        "我: “这里的樱花真的很美，就像梦境一样。”",
        "芙宁娜: “我觉得这里就像一个神秘的地方，充满了故事。”她的声音低得几乎听不见，但满脸的好奇和神秘感弥补了这一切。",
        "在神社参拜后，我们意外地遇见了稻妻的神社巫女，她对我们热情地介绍稻妻的传统文化。",
        "巫女: “希望你们能在这里找到新的灵感，感受稻妻的魅力。”",
        "我: “绝对会的！谢谢你的介绍！”",
        "傍晚时分，我们在神社旁的草坪上坐下，望着夕阳下的稻妻，随着晚霞的映照，整个世界仿佛被包裹在温暖的金色之中。",
        "芙宁娜: “今天真的是太特别了，我会永远记住这个地方！”",
        "我: “我们一定会再来，继续探索这里的每一处。”",
        "心中怀着对未来的期待，我们在稻妻的晚风中，计划着更多的冒险和旅行。这个旅程让我们的羁绊更加深厚，也让我们认识了更多崭新的世界。"
      ]
    } else if (this.which === "第十七章") {
      this.texts = [
        "我: “哇，稻妻的夜景真美”",
        "芙宁娜: “是啊，特别是那片樱花树下的光影，让我觉得仿佛置身于另一个世界。”",
        "我: “我们去那边的茶馆试试稻妻的抹茶吧？听说特别好喝！”",
        "芙宁娜: “好呀！我一直想尝试正宗的抹茶味道。”",
        "我: “走吧，顺路还可以欣赏一下这个世界的夜色。”",
        "芙宁娜: “听说稻妻的茶道很有讲究，我有点紧张。”",
        "我: “别担心，茶道的氛围其实挺放松的，只要我们享受就好。”",
        "芙宁娜: “嗯，好吧。如果我搞砸了，你一定要帮我。”",
        "我: “没问题！我会在旁边为你加油的。”",

        "茶师: “欢迎光临！你们想尝试什么茶？”",
        "我: “我们想要抹茶，最好能介绍一下你们的特色。”",
        "茶师: “好的，这里有传统的浓厚抹茶和清淡的抹茶，推荐你们试试清香味。”",
        "芙宁娜: “那我想要清淡的抹茶！”",
        "我: “我也是，一个清淡的抹茶。”",
        "茶师: “好的，请稍等。”",
        "芙宁娜: “真期待！我从来没有在茶馆喝过抹茶。”",
        "我: “这是个不错的体验，我想看看你会不会喜欢。”",
        "芙宁娜: “如果我喜欢的话，下一次我一定要自己尝试做！”",
        "我: “好啊，这样我们就可以在家里一起喝茶聊天了。”",
        "茶师: “这是你们的抹茶，请慢用。”",
        "我: “谢谢！”",

        "芙宁娜: “这个味道……真的好好喝！比我想的要细腻很多。”",
        "我: “是吧？这种清香真的是让人心旷神怡。”",
        "芙宁娜: “我现在明白为什么大家都喜欢茶道了，它真的很能让人放松。”",
        "我: “是啊，这也算是对生活的一种沉淀。”",
        "芙宁娜: “对了，你觉得我们应该去哪里逛逛？我听说建立在水面上的神社特别有意思。”",
        "我: “那就去吧！我也想看看那里的日出。”",
        "芙宁娜: “太棒了！我们明天就去！”",
        "我: “对了，咱们计划下明天的行程吧。去看看是否能参加祭典。”",
        "芙宁娜: “好主意！我听说祭典上有很多好玩的活动。”",
        "我: “没错，还有许多可以品尝的小吃。”",
        "芙宁娜: “如果有糖葫芦就好了，我想试试稻妻版的！”",
        "我: “哈哈，估计稻妻的糖葫芦也是独具风味的。”",
        "芙宁娜: “希望如此！明天一定会有很多好玩的事情。”",
        "我: “我们的冒险才刚刚开始！”",
        "芙宁娜: “跟着你，我总是充满期待！”",

        "我: “要不我们去周围走走，感受一下稻妻的夜风？”",
        "芙宁娜: “好呀，我也想听听大海的声音。”",
        "我: “今天真是个美好的夜晚，谢谢你陪我一起探索。”",
        "芙宁娜: “不客气，你是我的好朋友，跟着你我觉得无比快乐。”",
        "我: “我们这一路都不会孤单的！”",
        "芙宁娜: “对啊，今天真是难忘的一天。”"
      ]
    } else if (this.which === "第十八章") {
      this.texts = [
        "芙芙，快看！那边是纳西妲！我之前见过她！",
        "芙宁娜: 真的？她就是那位小神明吗？好可爱啊！",
        "我: 对对，我去跟她打招呼！",
        "我: 纳西妲！好久不见！你最近过得怎么样？",
        "纳西妲: 你们好呀！我很好，谢谢！你们来须弥吗？",
        "我: 没错！我和芙芙打算探索一下这里，听说这里有很多有趣的地方。",
        "芙宁娜: 你好，我是芙宁娜，很高兴认识你。",
        "纳西妲: 我早就听说过水神，能够亲自见到你真是太好了！",
        "我: 我们今天有什么特别的计划吗？",
        "纳西妲: 如果你们愿意，我可以带你们去看看须弥的秘密花园，那个地方很少有人去。",
        "芙宁娜: 那太棒了！我对秘密花园最感兴趣了！",
        "我: 那我们走吧，纳西妲，你带路！",
        "纳西妲: 好的，跟紧我哦！",
        "在前往秘密地点的路上，一路上充满了欢声笑语。",
        "我: 须弥的风景真漂亮，特别是这里的空气，感觉好清新！",
        "纳西妲: 这里的空气确实很特别，拥有许多魔力。",
        "芙宁娜: 我比起花草，更喜欢这种开阔的感觉！",
        "我: 对了，纳西妲，你喜欢旅行吗？",
        "纳西妲: 喜欢！我经常去各个地方，收集不同的故事和文化。",
        "芙宁娜: 听起来真不错！我们也有很多有趣的冒险经历！",
        "我: 说起来，纳西妲，你听说过我们的冒险故事吗？",
        "纳西妲: 有听说呢，尤其是你们去璃月的那次，我听说你们打败了好几个厉害的敌人！",
        "我: 没错，不过那次真是惊险万分！芙芙也表现得特别勇敢！",
        "芙宁娜: 哼，那当然！虽然我有点紧张，但我一直都在努力！",
        "纳西妲: 你们真的很厉害！冒险需要勇气和智慧，而你们两个都拥有。",
        "我: 谢谢你，纳西妲！今天的探险有你真是太好了！",
        "纳西妲: 我也很开心能和你们一起冒险，接下来会更有趣！",
        "我们继续沿着小路前行，期待着前方的秘密地点，心中充满了对未知世界的探索之情。"
