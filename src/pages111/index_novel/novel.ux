  },
  last() {
    if (this.level < 200) return
    router.push({
      uri: "/pages/novel_person",
      params: {which: "第二部分-终章", __PARAM_LAUNCH_FLAG___: "clearTask"}
    })
  },

  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index_story"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index_story"
    })
  }
}
</script>

