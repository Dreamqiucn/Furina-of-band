  getstone() {
    storage.get({
      key: "stone",
      success: (res) => {
        this.stone = res ? parseInt(res, 10) : 0
        this.stone = this.stone + 15
        storage.set({
          key: "stone",
          value: this.stone.toString()
        })
      }
    })
    prompt.showToast({
      message: "已获得15个原石",
      duration: 1000
