      "欢迎，我的依靠" + this.name + "，以后不管发生什么，我都相信你。"
    ]

    const greetingsMutualSupport = [
      "" + this.name + "，我们是彼此最重要的人，以后不管遇到什么，都要相互扶持。",
      this.name + "你终于来啦，我最近一直在想，要是没有你，我该怎么继续走下去。",
      "嘿，我并肩作战的伙伴" + this.name + "，我们一起创造了那么多回忆，以后还要更多。",
      "你好，我的奋斗伙伴" + this.name + "，我相信只要我们在一起，就没有什么做不到的。",
      "欢迎，我的坚定盟友" + this.name + "，以后的路还很长，我们一起走。"
    ]

    const greetingsDeepBond = [
      this.name + "，你终于来啦，我感觉我的灵魂都因为你的到来而欢呼雀跃。",
      this.name + "你好呀，我命中注定的" + this.name + "，我们的故事，才刚刚开始。",
      "欢迎回来，我的命运交织者" + this.name + "，不管未来有多少风雨，我们都一起面对。",
