<template>
  <div class="page download-page" @swipe="toHomePage">
    <div class="header column center">
      <text class="a">{{ gan1 }}武器</text>
    </div>
    <div class="header column center">
      <text class="c">灰河渡手</text>
    </div>
    <div class="body center">
      <div class="description center">
        <image class="icon" src="/common/icon/wuxiangbing.png"></image>
        <text class="d">之力注入到双"</text>
      </div>
    </div>
    <div class="footer column center">
      <div style="margin-top: 10px">
        <input
          class="but"
          type="button"
          value="使用"
          style="font-size: 30px; color: #ffffff"
          onclick="gana"
        />
      </div>
    </div>
    <div class="header column center">
      <text class="c">祭礼剑</text>
    </div>
    <div class="body center">
      <image class="icon" src="/common/icon/jing.png"></image>
    </div>
    <div class="footer column center">
      <div style="margin-top: 10px">
        <input
          class="but"
          type="button"
          value="挑战"
          style="font-size: 30px; color: #ffffff"
          onclick="ganb"
        />
      </div>
    </div>
    <div class="header column center">
      <text class="c">静水流涌之辉</text>
    </div>
    <div class="body center">
      <image class="icon" src="/common/icon/realqqw.png"></image>
    </div>
    <div class="footer column center">
      <div style="margin-top: 10px">
        <input
          class="but"
          type="button"
          value="挑战"
          style="font-size: 30px; color: #ffffff"
          onclick="qqw"
        />
      </div>
    </div>
    <div class="header column center">
      <text class="c">纯水精灵</text>
    </div>
    <div class="body center">
      <image class="icon" src="/common/icon/waterren.png"></image>
    </div>
    <div class="footer column center">
      <div style="margin-top: 10px">
        <input
          class="but"
          type="button"
          value="挑战"
          style="font-size: 30px; color: #ffffff"
          onclick="water"
        />
      </div>
    </div>
  </div>
</template>

<style>
.back {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 72px;
  height: 72px;
  opacity: 0.7;
}

.description {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 20px;
  padding: 30px;

  margin: 0 auto;
  /* Center align */
}

.icon {
  width: 100%;
  flex: 50%;
}

.but {
  width: 80%;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30px;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

