      [1500, [1460, 1500], [82000000, 95000000]],
      [1540, [1500, 1540], [95000000, 110000000]],
      [1580, [1540, 1580], [110000000, 127000000]],
      [1620, [1580, 1620], [127000000, 146000000]],
      [1660, [1620, 1660], [146000000, 168000000]],
      [1700, [1660, 1700], [168000000, 193000000]],
      [1740, [1700, 1740], [193000000, 221000000]],
      [1780, [1740, 1780], [221000000, 253000000]],
