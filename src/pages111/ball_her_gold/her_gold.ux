<template>
  <div class="page download-page">
    <div if="{{ first == false }}" class="header column center">
      <text>结果</text>
      <text>命之座-司颂座</text>
      <text>获得物品：1</text>
    </div>

    <div if="{{ first == false }}" class="center column">
      <image class="icon2" src="/common/icon/ming.png"></image>
      <text>当前拥有：x {{ currentCount }}</text>
    </div>

    <image
      class="back"
      if="{{ first == false }}"
      src="/common/icon/back.png"
      onclick="back"
    ></image>
    <image class="bg" if="{{ first }}" src="{{ bg }}" onclick="bgg"></image>
  </div>
</template>

<style>
.back {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
}

.item {
  display: flex;
  justify-content: flex-end;
  /* 向右对齐 */
  align-items: center;
}

.info {
  /* 一块区域 */
  width: 335px;
  flex: 1;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.info {
  /* 一块区域 */
  width: 100%;
  margin-top: 0px;
}

.center {
  align-items: center;
  justify-content: center;
}

.page {
  background-color: #000000;
  width: 100%;
  height: 480px;
  flex: 1;
}

.icon2 {
  width: 90px;
  height: 90px;
}

.bg {
  width: 90%;
  height: 90%;
}
</style>

<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"

// 武器配置映射表

export default {
  public: {
    star: 0,
    first: true,
    bg: "/common/icon/zi.png",
    goods: "/common/icon/cake.png",
    itemName: "物品名称",
    currentCount: 0 // 新增当前数量显示
  },
  bgg() {
    this.first = false
  },
  // 修改后的库存更新方法

  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })

    storage.set({
      key: "wx",
      value: "0"
    })
    this.bg = "/common/icon/gold.png"
    storage.get({
      key: "ming",
      success: (data) => {
        const old = data ? parseInt(data, 10) : 0
        const newCount = old + 1
        storage.set({
          key: "ming",
          value: newCount.toString()
        })
        this.currentCount = newCount
      }
    })
  },

  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index_ball_her"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index_ball_her"
    })
  }
}
</script>
