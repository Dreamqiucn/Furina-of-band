<template>
  <div class="page download-page" @swipe="toHomePage">
    <div class="header column center">
      <div class="column center">
        <text class="a">常驻池</text>
        <text onclick="changzhu" class="e">武器池</text>
        <text onclick="juese" class="e">角色池</text>
      </div>
      <text class="b">数目：{{ money }}</text>
    </div>
    <div class="body column center">
      <image class="icon" src="/common/icon/blueball.png"></image>
    </div>
    <div class="footer column center">
      <div style="margin-top: 10px">
        <input
          class="but"
          type="button"
          value="十连"
          style="font-size: 30px; color: #ffffff"
          onclick="handleButtonClick"
        />
      </div>
    </div>
  </div>
</template>

<style>
.back {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 0.5;
  z-index: 1000;
}

.but {
  width: 80%;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30px;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.center {
  align-items: center;
  justify-content: center;
}

.header {
  margin-top: 20px;
}

.page {
  justify-content: center;

  background-color: #000000;
  flex: 1;
}

.body {
  margin-top: 10px;
}

.footer {
  margin-top: 10px;
  margin-left: 15px;
}

.icon {
  width: 156px;
  height: 156px;
}

.a {
  font-size: 35px;
}

.b {
  font-size: 30px;
  color: #d1c5c5;
}

.e {
  font-size: 35px;
  color: #c9c9c9;
}
</style>

<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

export default {
  public: {
    today: 0,
    lastdayb: 0,
    money: 0,
    adjustedAa: 0
  },
  changzhu() {
    router.push({uri: "/pages/index_ball_pink"})
  },
  juese() {
    router.push({uri: "/pages/index_ball_her"})
  },
  idea() {
    router.push({
      uri: "/pages/index_ideaall",
      params: {
        rule: "武器池需要原石换成纠缠之缘抽取，常驻池可以自定义获得相遇之缘。（原石通过无尽模式每关可获得20）"
      }
    })
  },
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })

    const today = new Date()
    const adjustedAa = today.getDay() === 0 ? 7 : today.getDay() // 将星期数转换为1-7的格式

    storage.get({
      key: "lastdayb",
      success: (resB) => {
        this.lastdayb = resB ? parseInt(resB, 10) : 0 // 获取并设置 lastday
        //如果 lastday 与 adjustedA 相等，说明今天已经更新过 level，不需要更新
        //如果 lastday 是 6 且 adjustedA 是 7，说明今天是星期日，需要更新 level
        if (adjustedAa !== this.lastdayb && adjustedAa < 7) {
          // 更新 lastday 和 level
          storage.set({
            key: "lastdayb",
            value: adjustedAa === 7 ? 0 : adjustedAa.toString()
            // 如果 adjustedA 是 7，说明今天是星期日，需要将 lastday 置为 0
          })

          storage.get({
            key: "money",
            success: (resmm) => {
              this.money = resmm ? parseInt(resmm, 10) : 0
              this.money += 10
              storage.set({
                key: "money",
                value: this.money.toString()
              })
            }
          })
        } else if (adjustedAa === 7 && this.lastdayb === 6) {
          storage.set({
            key: "lastdayb",
            value: "0"
          })
          storage.get({
            key: "money",
            success: (resmm) => {
              this.money = resmm ? parseInt(resmm, 10) : 0
              this.money += 10
              storage.set({
                key: "money",
                value: this.money.toString()
              })
            }
          })
        } else if (adjustedAa === this.lastdayb || (adjustedAa === 7 && this.lastdayb === 0)) {
          // 不更新 level
          storage.get({
            key: "money",
            success: (resmm) => {
              this.money = resmm ? parseInt(resmm, 10) : 10
            }
          })
        }
      }
    })
  },
  decreaseA() {
    storage.set({
      key: "money",
      value: (this.money - 10).toString(),
      success: (resp) => {
        this.money = parseInt(resp.value, 10)
      }
    })
  },
  redirectToRandomPage() {
    const randomNumber = Math.floor(Math.random() * 100) + 1
    if (randomNumber >= 1 && randomNumber < 50) {
      router.replace({
        uri: "/pages/ball_one"
      })
    } else if (randomNumber >= 50 && randomNumber < 70) {
      router.replace({
        uri: "/pages/ball_two"
      })
    } else if (randomNumber >= 70 && randomNumber <= 100) {
      router.replace({
        uri: "/pages/ball_three"
      })
    }
  },
  handleButtonClick() {
    if (this.money < 10) {
      return
    }
    this.decreaseA()
    this.redirectToRandomPage()
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index"
    })
  }
}
</script>
