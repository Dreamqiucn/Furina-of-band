      [2980, [2940, 2980], [12300000000, 14050000000]],
      [3020, [2980, 3020], [14050000000, 16050000000]],
      [3060, [3020, 3060], [16050000000, 18340000000]],
      [3100, [3060, 3100], [18340000000, 20950000000]],
      [3140, [3100, 3140], [20950000000, 23930000000]],
      [3180, [3140, 3180], [23930000000, 27340000000]],
      [3220, [3180, 3220], [27340000000, 31230000000]],
      [3260, [3220, 3260], [31230000000, 35680000000]],
      [3300, [3260, 3300], [35680000000, 40760000000]],
      [3340, [3300, 3340], [40760000000, 46570000000]],
      [3380, [3340, 3380], [46570000000, 53200000000]],
      [3420, [3380, 3420], [53200000000, 60780000000]],
      [3460, [3420, 3460], [60780000000, 69440000000]],
