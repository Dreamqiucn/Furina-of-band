<template>
  <div class="page center" @swipe="toHomePage">
    <!-- 抽卡背景 -->
    <image if="{{ first }}" class="gacha-bg" src="{{ imgsrc }}" onclick="bg"></image>

    <!-- 十连结果 -->
    <div if="{{ !first }}" class="result-container column center">
      <!-- 保底信息 -->
      <div class="pity-info column center">
        <text class="pity-text">结果</text>
        <text class="pity-text">五星保底：{{ wx }}/90</text>
        <text class="pity-text">四星保底：{{ fourStarPity }}/10</text>
      </div>

      <!-- 结果网格 -->
      <div class="result-grid">
        <div for="{{ results }}" class="item column center">
          <image class="item-icon" src="{{ $item.icon }}"></image>
          <text class="item-name rarity-{{ $item.rarity }}">{{ $item.name }}</text>
        </div>
      </div>

      <!-- 返回按钮 -->
      <image class="back-btn" src="/common/icon/back.png" onclick="back"></image>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "../../common/storage.js"

const BASE_5STAR_RATE = 6 // 0.6%
const BASE_4STAR_RATE = 51 // 5.1%
const SOFT_PITY_START = 74 // 软保底起始

const WEAPON_MAP = {
  // 五星武器
  zhuanwu: {
    name: "静水流涌之辉",
    icon: "/common/icon/zhuanwu.png",
    rarity: 5,
    key: "zhuanwu"
  },

  // 四星武器
  jlj: {
    name: "祭礼剑",
    icon: "/common/icon/jlj.png",
    rarity: 4,
    key: "jlj"
  },
  huihe: {
    name: "灰河渡手",
    icon: "/common/icon/huihe.png",
    rarity: 4,
    key: "huihe"
  },
  shuixian: {
    name: "水仙十字剑",
    icon: "/common/icon/shuixian.png",
    rarity: 4,
    key: "shuixian"
  },
  changjian: {
    name: "船坞长剑",
    icon: "/common/icon/changjian.png",
    rarity: 4,
    key: "changjian"
  }
}

export default {
  public: {
    first: true,
    results: [],
    wx: null,
    fourStarPity: 0,
    imgsrc: "/common/icon/zi.png"
  },
  bg() {
    this.first = false
  },
  async doTenPull() {
    this.results = []
    let hasHighRarity = false

    for (let i = 0; i < 10; i++) {
      // 使用Promise包装storage.get以确保顺序执行
      const data = await new Promise((resolve, reject) => {
        storage.get({
          key: "wx",
          success: resolve,
          fail: reject
        })
      })
      this.wx = parseInt(data || 0)

      // 每次抽卡仅增加1次计数
      this.wx += 1
      if (this.wx > 90) this.wx = 0

      await new Promise((resolve, reject) => {
        storage.set({
          key: "wx",
          value: this.wx.toString(),
          success: resolve,
          fail: reject
        })
      })

      const force4Star = i === 9 && !hasHighRarity
      const result = await this.singlePull(force4Star)

      this.results = [...this.results, result]
      if (result.rarity >= 4) hasHighRarity = true

      this.updatePityCounters(result)
    }

    this.savePityData()
  },

  async singlePull(force4Star = false) {
    // 保底优先级调整：79触发五星保底
    if (this.wx >= 79) return this.get5StarItem() // 修改此行
    if (force4Star || this.fourStarPity >= 9) return this.get4StarItem()
    // 概率计算
    const rand = Math.floor(Math.random() * 1000)
    const current5Rate = this.getCurrent5StarRate()

    if (rand < current5Rate) {
      return this.get5StarItem()
    } else if (rand < current5Rate + BASE_4STAR_RATE) {
      return this.get4StarItem()
    } else {
      storage.get({
        key: "cake",
        success: (data) => {
          this.cake = parseInt(data || 0) + 1
          this.cake += 1
          storage.set({key: "cake", value: this.cake.toString()})
        }
      })
      return this.get3StarItem()
    }
  },

  getCurrent5StarRate() {
    if (this.wx < SOFT_PITY_START) return BASE_5STAR_RATE
    return BASE_5STAR_RATE + (this.wx - SOFT_PITY_START + 1) * 60
  },

  // 物品生成方法
  get5StarItem() {
    this.imgsrc = "/common/icon/gold.png"
    this.wx = 0
    storage.set({key: "wx", value: this.wx.toString()})
    this.updateInventory(WEAPON_MAP.zhuanwu.key)
    return WEAPON_MAP.zhuanwu
  },

  get4StarItem() {
    const keys = ["jlj", "huihe", "shuixian", "changjian"]
    const randomKey = keys[Math.floor(Math.random() * keys.length)]
    this.updateInventory(WEAPON_MAP[randomKey].key)
    return WEAPON_MAP[randomKey]
  },

  get3StarItem() {
    return {
      name: "小蛋糕",
      icon: "/common/icon/cake.png",
      rarity: 3,
      key: null // 不存储的标识
    }
  },

  // 库存管理
  updateInventory(itemKey) {
    if (!itemKey) return // 不存储key为null的物品

    storage.get({
      key: "inventory",
      success: (data) => {
        const inventory = data ? JSON.parse(data) : {}
        inventory[itemKey] = (inventory[itemKey] || 0) + 1
        storage.set({key: "inventory", value: JSON.stringify(inventory)})
      }
    })
  },

  // 保底计数器更新
  updatePityCounters(result) {
    if (result.rarity === 5) {
      this.wx = 0
      this.fourStarPity += 1
    } else if (result.rarity === 4) {
      this.fourStarPity = 0
    } else {
      this.fourStarPity += 1
    }

    // 数值修正
    this.wx = Math.min(this.wx, 89)
    this.fourStarPity = Math.min(this.fourStarPity, 9)
  },

  // 数据持久化
  savePityData() {
    storage.set({key: "wx", value: this.wx.toString()})
    storage.set({key: "fourStarPity", value: this.fourStarPity.toString()})
  },

  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    // 初始化保底数据
    storage.get({
      key: "wx",
      success: (data) => (this.wx = data ? parseInt(data, 10) : 0)
    })
    storage.get({
      key: "fourStarPity",
      success: (data) => (this.fourStarPity = parseInt(data || 0))
    })
    this.doTenPull()
  },
  back() {
    router.replace({uri: "/pages/index_ball_pink"})
  }
}
</script>

<style>
.center {
  align-items: center;
  justify-content: center;
}

.page {
  flex-direction: column;
  background-color: #000000;
  height: 100%;
  display: flex;
  flex: 1;
}

.gacha-bg {
  width: 100%;
  height: 100%;
}

.result-container {
  flex: 1;
}

.pity-info {
  opacity: 1;
  border-radius: 36px;
  background: rgb(122, 122, 122);
  border: 3px solid rgba(255, 255, 255, 0.06);

  margin-bottom: 15px;
}

.pity-text {
  color: #ffffff;
  font-size: 20px;
}

.result-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.result-item {
  width: 30%;
  border-radius: 36px;
  background: rgb(73, 73, 73);
  justify-content: center;
  align-items: center;
  padding: 5px;
}

.item-icon {
  width: 70%;
  height: 70%;
}

.item-name {
  font-size: 20px;
  text-align: center;
}

.rarity-5 {
  color: #ffd700;
}

/* 金色 */
.rarity-4 {
  color: #c13cff;
}

/* 紫色 */
.rarity-3 {
  color: #8c8c8c;
}

/* 灰色 */

.back-btn {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
}

.column {
  flex-direction: column;
}

.result-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  opacity: 1;
  border-radius: 36px;
  background: rgba(38, 38, 38, 1);
  border: 3px solid rgba(255, 255, 255, 0.06);
}

.item {
  width: 19%;
  opacity: 1;
  border-radius: 36px;
  background: rgb(100, 100, 100);

  border: 3px solid rgba(255, 255, 255, 0.06);
  position: relative;
}

.item-icon {
  width: 60px;
  height: auto;
}

.result-header {
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.result-title {
  font-size: 28px;
  color: #ffd700;
  margin-bottom: 8px;
}
</style>
