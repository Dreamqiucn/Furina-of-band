    } else {
      // 如果好感度不在1到90之间，可以选择默认的消息
      greetingsArray = greetings
    }

    const randomIndex = Math.floor(Math.random() * greetingsArray.length)
    return greetingsArray[randomIndex]
  },
  say() {
    // 点击图标，触发 say 方法
    prompt.showToast({
      message: this.getRandomGreeting(this.level),
      duration: 2500
    })
    const imagechange = Math.floor(Math.random() * 4)
    if (imagechange == 1) {
      this.imgsrc = "/common/icon/ff1.png"
    } else if (imagechange == 2) {
      this.imgsrc = "/common/icon/ff2.png"
    } else if (imagechange == 3) {
      this.imgsrc = "/common/icon/ff3.png"
    } else {
      this.imgsrc = "/common/icon/ff4.png"
    }

    const today = new Date()
  },
  exit() {
    // 退出应用
    this.$app.exit()
  },
  ban() {
    return
  },
  routePage1() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_more"
    })
  },
  routePage2() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_ball_pink"
    })
  },
  routePage3() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_things"
    })
  },
  routePage8() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_about"
    })
  },
  routePage5() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_story"
    })
  },
  routePage7() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_maoxian_choose"
    })
  },
  routePage6() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_idea"
    })
  },

  routePage4() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_need"
    })
  },
  changeName() {
    if (this.ffname == "Furina") {
      this.ffname = "芙宁娜"
    } else if (this.ffname == "芙宁娜") {
      this.ffname = "Furina"
    }
  }
}
