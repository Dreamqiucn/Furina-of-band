<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

export default {
  public: {
    today: 0,
    lastdayz: 0,
    numberthing: 0,
    adjustedAa: 0,
    aka: 0,
    ake: 0,
    akq: 0,
    blood: 0,
    mxlv: 0,
    j: 0,
    cishu: 0,
    nsaka: 0,
    nsake: 0,
    nsakq: 0,
    nsblood: 0,
    nsjf: 0,
    nstf: 0,
    jys: 0,
    tfs: 0,
    level: 0,
    jieduan: 0,
    money: 0,
    cake: 0,
    uncake: 0,
    food: 0,
    stone: 0
  },

  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    const today = new Date()
    const adjustedAa = today.getDay() === 0 ? 7 : today.getDay() // 将星期数转换为1-7的格式
    storage.get({
      key: "level",
      success: (res) => {
        this.level = res ? parseInt(res, 10) : 5
      }
    })
    storage.get({
      key: "jieduan",
      success: (res) => {
        this.jieduan = res ? parseInt(res, 10) : 1
      }
    })
    storage.get({
      key: "blood",
      success: (res) => {
        this.blood = res ? parseInt(res, 10) : 1193
      }
    })
    storage.get({
      key: "nsblood",
      success: (res) => {
        this.nsblood = res ? parseInt(res, 10) : 1000
      }
    })
    storage.get({
      key: "mxlv",
      success: (res) => {
        this.mxlv = res ? parseInt(res, 10) : 1
      }
    })
    storage.get({
      key: "tfs",
      success: (res) => {
        this.tfs = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "nstf",
      success: (res) => {
        this.nstf = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "jys",
      success: (res) => {
        this.jys = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "nsjf",
      success: (res) => {
        this.nsjf = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "nsake",
      success: (res) => {
        this.nsake = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "nsakq",
      success: (res) => {
        this.nsakq = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "nsaka",
      success: (res) => {
        this.nsaka = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "aka",
      success: (res) => {
        this.aka = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "ake",
      success: (res) => {
        this.ake = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "akq",
      success: (res) => {
        this.akq = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "cake",
      success: (res) => {
        this.cake = res ? parseInt(res, 10) : 1
      }
    })
    storage.get({
      key: "uncake",
      success: (res) => {
        this.uncake = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "food",
      success: (res) => {
        this.food = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "cishu",
      success: (res) => {
        this.numberthing = res ? parseInt(res, 10) : 6
      }
    })
    storage.get({
      key: "j",
      success: (res) => {
        this.j = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "lastdayz",
      success: (resB) => {
        this.lastdayz = resB ? parseInt(resB, 10) : 0 // 获取并设置 lastday
        //如果 lastday 与 adjustedA 相等，说明今天已经更新过 level，不需要更新
        //如果 lastday 是 6 且 adjustedA 是 7，说明今天是星期日，需要更新 level
        if (adjustedAa !== this.lastdayz && adjustedAa < 7) {
          // 更新 lastday 和 level
          storage.set({
            key: "lastdayz",
            value: adjustedAa === 7 ? 0 : adjustedAa.toString()
            // 如果 adjustedA 是 7，说明今天是星期日，需要将 lastday 置为 0
          })

          storage.get({
            key: "numberthing",
            success: (resmm) => {
              this.numberthing = resmm ? parseInt(resmm, 10) : 0
              this.numberthing += 3
              storage.set({
                key: "numberthing",
                value: this.numberthing.toString()
              })
            }
          })
        } else if (adjustedAa === 7 && this.lastdayz === 6) {
          storage.set({
            key: "lastdayz",
            value: "0"
          })
          storage.get({
            key: "numberthing",
            success: (resmm) => {
              this.numberthing = resmm ? parseInt(resmm, 10) : 0
              this.numberthing += 3
              storage.set({
                key: "numberthing",
                value: this.numberthing.toString()
              })
            }
          })
        } else if (adjustedAa === this.lastdayz || (adjustedAa === 7 && this.lastdayz === 0)) {
          // 不更新 level
          storage.get({
            key: "numberthing",
            success: (resmm) => {
              this.numberthing = resmm ? parseInt(resmm, 10) : 3
            }
          })
        }
      }
    })
  },

  decreaseA() {
    storage.get({
      key: "numberthing",
      success: (resca) => {
        this.numberthing = resca ? parseInt(resca, 10) : 3
        if (this.numberthing <= 0) {
          return
        }
        this.numberthing -= 1
        storage.set({
          key: "numberthing",
          value: this.numberthing.toString()
        })
      }
    })
  },

  redirectToRandomPage() {
    const randomNumber = Math.floor(Math.random() * 28) + 1
    switch (randomNumber) {
      case 1:
        storage.get({
          key: "level",
          success: (result) => (this.level = result ? parseInt(result, 10) : 0)
        })
        this.level -= 5
        storage.set({
          key: "level",
          value: this.level.toString()
        })
        prompt.showToast({
          message: "芙芙今天不是很开心，好感度下降5%",
          duration: 2000
        })
        break
      case 2:
        storage.get({
          key: "level",
          success: (result) => (this.level = result ? parseInt(result, 10) : 0)
        })
        this.level += 5
        storage.set({
          key: "level",
          value: this.level.toString()
        })
        prompt.showToast({
          message: "芙芙今天额外的开心，好感度增加5%",
          duration: 2000
        })
        break
      case 3:
        storage.get({
          key: "mxlv",
          success: (result) => (this.mxlv = result ? parseInt(result, 10) : 0)
        })
        this.mxlv += 5
        storage.set({
          key: "mxlv",
          value: this.mxlv.toString()
        })
        prompt.showToast({
          message: "芙芙今天太想进步了，冒险等级加5",
          duration: 2000
        })
        break
      case 4:
        storage.get({
          key: "mxlv",
