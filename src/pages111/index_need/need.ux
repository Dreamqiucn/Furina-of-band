  navigateToPage(x, y, index) {
    console.log(x, y, index)
    console.log(this.wt[index])
    console.log(this.wt.length)
    if (
      this.wt[index].finish === "未完成" &&
      this.wt[index].name !== "1" &&
      this.wt[index].name !== "2" &&
      this.wt[index].name !== "3" &&
      this.wt[index].name !== "4"
    ) {
      if (this.wt[index].name !== "把突发事件次数用光") {
        if (this.wt[index].replace !== "need_question") {
          console.log("点的是" + this.wt[index].which)
          this.wt[index].finish = "已完成"
          this.getstone()
          storage.set({
            key: "wt",
            value: JSON.stringify(this.wt)
          })
          if (x !== null && y === null) {
            router.push({
              uri: "/pages/need_question",
              params: {
                which: x
              }
            })
          } else if (x === null && y !== null) {
            if (y === "maoxian_nostop") {
              console.log("maoxian_nostop")
              const monster = Math.floor(Math.random() * 3) + 1
              console.log(monster)
              if (monster === 1) {
                router.push({
                  uri: "/pages/maoxian_nostop",
                  params: {
                    which: "丘丘人"
                  }
                })
              } else if (monster === 2) {
                router.push({
                  uri: "/pages/maoxian_nostop",
                  params: {
                    which: "丘丘暴徒"
                  }
                })
              } else if (monster === 3) {
                router.push({
                  uri: "/pages/maoxian_nostop",
                  params: {
                    which: "丘丘王"
                  }
                })
              }
            } else {
              router.push({
                uri: "/pages/" + y,
                params: {
                  couldback: false
                }
              })
            }
          } else if (x !== null && y !== null) {
            if (y === "maoxian_putong") {
              if (x === "guaiwu" && y === "maoxian_putong") {
                const monster = Math.floor(Math.random() * 4) + 1
                if (monster === 1) {
                  this.change1 = "丘丘人"
                } else if (monster === 2) {
                  this.change1 = "丘丘暴徒"
                } else if (monster === 3) {
                  this.change1 = "丘丘王"
                } else if (monster === 4) {
                  this.change1 = "丘丘岩盔王"
                }
                router.push({
                  uri: "/pages/maoxian_putong",
                  params: {
                    which: this.change1,
                    couldback: false
                  }
                })
              } else {
                router.push({
                  uri: "/pages/" + y,
                  params: {
                    which: x,
                    couldback: false
                  }
                })
              }
            } else {
              router.push({
                uri: "/pages/" + y,
                params: {
                  which: x,
                  couldback: false
                }
              })
            }
          }
        } else {
          router.push({
            uri: "pages/need_question",
            params: {
              question: x,
              id: index
            }
          })
        }
      } else if (this.wt[index].name === "把突发事件次数用光") {
        console.log("点的是" + this.wt[index].name)
        storage.get({
          key: "numberthing",
          success: (res) => {
            this.numberthing = res ? parseInt(res, 10) : 6
            console.log("numberthingwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww" + this.numberthing)
            if (this.numberthing === 0) {
              this.wt[index].finish = "已完成"
              this.getstone()
              storage.set({
                key: "wt",
                value: JSON.stringify(this.wt)
              })
            } else {
              router.push({
                uri: "/pages/index_things"
              })
            }
          }
        })
      }
    } else {
      prompt.showToast({
        message: "该委托已经完成",
        duration: 1000
      })
    }
  },

  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index"
    })
  }
}
</script>

