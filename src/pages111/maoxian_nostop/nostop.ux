          duration: 500
        })
        setTimeout(() => this.processEnemyTurn(), 1500)
        this.visible = false
        if (this.qqnsblood <= 0) {
          this.handleGameOver("/pages/maoxian_nostop_goods")
        }
      }
    }
  },

  ak3dun() {
    if (this.ak33 <= 0 && this.dunvisible === false) {
      this.nsaka = Math.round(this.nsaka * 1.25)
      this.nsake = Math.round(this.nsake * 1.25)
      this.nsakq = Math.round(this.nsakq * 1.25)
      this.qqnsblood -= Math.round(this.nsakq)
      prompt.showToast({
        message: "增伤25%",
        duration: 1000
      })
      prompt.showToast({
        message: "芙宁娜造成" + Math.round(this.nsakq) + "点伤害",
        duration: 500
      })
      this.b = 0
      this.ak33 += 2
      setTimeout(() => this.processEnemyTurn(), 1500)
      this.visible = false
      if (this.qqnsblood <= 0) {
        this.handleGameOver("/pages/maoxian_nostop_goods")
      }
    } else if (this.ak33 === 0 && this.dunvisible === true) {
      this.nsaka = Math.round(this.nsaka * 1.25)
      this.nsake = Math.round(this.nsake * 1.25)
      this.nsakq = Math.round(this.nsakq * 1.25)
      this.dun -= Math.round(this.nsakq)
      prompt.showToast({
        message: "增伤25%",
        duration: 1000
      })
      prompt.showToast({
        message: "芙宁娜对护盾造成" + Math.round(this.nsakq) + "点伤害",
        duration: 1000
      })
      this.b = 0
      this.ak33 += 2
      setTimeout(() => this.processEnemyTurn(), 1500)
      this.visible = false

      if (this.dun <= 0) {
        this.dunvisible = false
      }
    }
  },
  timeClick() {
    if (this.clickCount === 0) {
      // 第一次点击，开始计时

      this.remainingTime = 3
      this.icetextvisible = true
      this.clickTimer = setTimeout(() => {
        if (this.clickCount < 10) {
          this.remainingTime = 0
          this.icetextvisible = false
          prompt.showToast({
            message: "未解冻成功，敌人再次攻击",
            duration: 1000
          })
          clearTimeout(this.clickTimer)
          this.clickTimer = null // 确保计时器被置为null
          clearInterval(this.interval)
          this.interval = null
          this.clickCount = 0
          // 如果3秒内点击次数不足10次，提示并重置计数器
          this.icevisible = false
          this.processEnemyTurn()
          this.b = 1
        }
      }, 3000)

      // 每秒更新一次剩余时间
      this.interval = setInterval(() => {
        if (this.remainingTime > 0) {
          this.remainingTime--
        } else {
          clearInterval(this.interval)
          this.interval = null
        }
      }, 1000)
    }

    this.clickCount++

    if (this.clickCount >= 10) {
      this.icevisible = false
      this.icetextvisible = false
      this.b = 1
      this.visible = true
      clearTimeout(this.clickTimer)
      this.clickTimer = null // 确保计时器被置为null
      clearInterval(this.interval)
      this.interval = null
      this.clickCount = 0

      prompt.showToast({
        message: "点击次数达到10次，芙宁娜解冻了！",
        duration: 1000
      })
    }
  },
  handleGameOver(uri) {
    router.replace({uri})
  },
  whichA() {
    if (
      this.which === "丘丘人" ||
      this.which === "丘丘暴徒" ||
      this.which === "无相之冰" ||
      this.which === "浮游风蕈兽" ||
      this.which === "丘丘王" ||
      this.which === "海乱鬼" ||
      this.which === "原海异种" ||
      this.which === "吞星之鲸"
    ) {
      this.ak1(1)
    } else if (this.which === "丘丘岩盔王") {
      this.ak1dun()
    } else if (this.which === "浮游草蕈兽") {
      this.ak1(1.2)
    } else if (this.which === "浮游水蕈兽" || this.which === "纯水精灵") {
      this.ak1(0.8)
    }
  },

  whichB() {
    if (
      this.which === "丘丘人" ||
      this.which === "丘丘暴徒" ||
      this.which === "无相之冰" ||
      this.which === "浮游风蕈兽" ||
