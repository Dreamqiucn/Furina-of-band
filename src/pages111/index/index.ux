      "欢迎，我的恋人" + this.name + "，从现在起，我们的关系不一样了哦。"
    ]
    let greetingsArray

    if (affection >= 1 && affection <= 10) {
      greetingsArray = greetingsLowAffection
    } else if (affection >= 11 && affection <= 20) {
      greetingsArray = greetingsMediumAffection
    } else if (affection >= 21 && affection <= 30) {
      greetingsArray = greetingsHighAffection
    } else if (affection >= 31 && affection <= 40) {
      greetingsArray = greetingsVeryFamiliar
    } else if (affection >= 41 && affection <= 50) {
      greetingsArray = greetingsCloseTrust
    } else if (affection >= 51 && affection <= 60) {
      greetingsArray = greetingsCloseTrust
    } else if (affection >= 61 && affection <= 70) {
      greetingsArray = greetingsMutualSupport
    } else if (affection >= 71 && affection <= 80) {
      greetingsArray = greetingsDeepBond
    } else if (affection >= 81 && affection <= 90) {
