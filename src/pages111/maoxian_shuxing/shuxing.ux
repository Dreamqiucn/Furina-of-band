},
  eatCake() {
    
    storage.get({
      key: "cake",
      success: (resca) => {
        this.cake = resca ? parseInt(resca, 10) : 0
        if (this.cake <= 0) {
          return
        }
        this.cake -= 1
        this.live = 1
        storage.set({
          key: "cake",
          value: this.cake.toString()
        })
        storage.set({
          key: "live",
          value: this.live.toString(),
          success: (a) => {
            this.see = false
          }
        })

      }
    })
  },
    onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
