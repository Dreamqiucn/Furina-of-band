              which: "浮游水蕈兽"
            }
          })
      }, 1000)
    } else if (this.monster === 5) {
      this.realmonster = "浮游草蕈兽"
      this.remind = "“水和草好像会使伤害提高”"
      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
