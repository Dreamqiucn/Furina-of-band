      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "原海异种"
        }
      })
    } else if (this.monster === 11) {
      router.push({
        uri: "/pages/maoxian_nostop",
        params: {
          which: "纯水精灵"
        }
      })
    } else if (this.monster === 12) {
