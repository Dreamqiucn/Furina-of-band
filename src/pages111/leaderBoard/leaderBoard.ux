<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="bg" @swipe="toHomePage">
    <div if="{{ enterPage=='rank' }}" class="page">
      <scroll scroll-y="true" scroll-x="true" bounces="true" class="scroll">
        <div class="rank1">
          <text class="rank-text"></text>
        </div>
        <div for="{{ list }}" class="rank column">
          <text class="rank-text" style="color: {{ $idx < 3 ? colorList[$idx] : '#ffffff' }}">
            {{ $idx + 1 }}. {{ $item.userName }}:{{ $item.score }}
          </text>
          <text class="rank-text" style="color: rgba(255, 255, 255, 0.5)">
            设备码:{{ $item.serial }}
          </text>
          <text class="rank-text" style="color: rgba(255, 255, 255, 0.5); font-size: 20px">
            {{ $item.band }}
          </text>
        </div>
        <div class="rank1">
          <text class="rank-text"></text>
        </div>
      </scroll>
      <image class="cover" src="/common/icon/cover.png"></image>
      <image class="cover1" src="/common/icon/cover1.png"></image>

      <text class="title" @click="enterUserName">无尽排行榜</text>
      <text class="user">{{ userName }}: {{ rank }}</text>
      <image
        src="/common/icon/refresh.png"
        style="position: absolute; width: 72px; height: 72px; top: 8px; right: 8px; opacity: 0.5"
        @click="check"
      />
      <image
        src="/common/icon/notice.png"
        style="position: absolute; width: 72px; height: 72px; top: 100px; right: 8px; opacity: 0.5"
        @click="notice1"
      />
      <image
        src="/common/icon/back.png"
        style="
          position: absolute;
          left: 49.69px;
          top: 6.63px;
          width: 112.62px;
          height: 79.5px;
          opacity: 0.5;
        "
        @click="back"
      />
    </div>
    <div if="{{ enterPage=='setname' }}" class="page">
      <text
        style="
          position: absolute;
          top: 120px;
          width: 100%;
          text-align: center;
          color: #ffffff;
          font-size: 32px;
          font-weight: bold;
        "
      >
        {{ userName }}_
      </text>
      <input-method
        hide="{{ hide }}"
        keyboardtype="QWERTY"
        maxlength="5"
        screentype="rect"
        @delete="ondelete"
        @complete="oncomplete"
      ></input-method>
      <text class="title" @click="enter">输入用户名</text>
      <image
        src="/common/icon/yes.png"
        style="position: absolute; width: 72px; height: 72px; top: 8px; right: 8px; opacity: 1"
        @click="enter"
      />
      <image
        src="/common/icon/back.png"
        style="
          position: absolute;
          left: 49.69px;
          top: 6.63px;
          width: 112.62px;
          height: 79.5px;
          opacity: 0.5;
        "
        @click="back"
      />
    </div>
    <div if="{{ enterPage=='notice' }}" class="page">
      <scroll
        style="
          margin-top: 80px;
          width: 100%;
          height: auto;
          opacity: 1;
          border-radius: 26px;
          background-color: rgba(46, 46, 46, 0.47);
          flex-wrap: wrap;
          flex: 1;
        "
        scroll-y="true"
        bounces="true"
      >
        <text style="font-size: 30px; color: #ffffff; width: 100%">禁止恶意利用bug刷榜</text>

        <text style="font-size: 30px; color: #ffffff; width: 100%">
          {{ notice }}
        </text>
      </scroll>

      <!-- <div for="{{Object.keys(notice)}}" class="rank">
          <text class="rank-text" style="color: #ffffff">{{ notice[$idx] }}</text>
        </div> -->

      <text class="title" @click="enterUserName">封禁公布</text>
      <image
        src="/common/icon/back.png"
        style="
          position: absolute;
          left: 49.69px;
          top: 6.63px;
          width: 112.62px;
          height: 79.5px;
          opacity: 1;
        "
        @click="backnotice"
      />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import fetch from "@system.fetch"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"
import interconnect from "@system.interconnect"
import device from "@system.device"
function getRandomInt(min, max) {
  return Math.floor(Math.random() * (max - min + 1)) + min
}
function convertDeviceCode(deviceCode) {
  // 正则表达式匹配第一位是大写字母或数字，后五位是数字的设备码
  if (/^[A-Z0-9][0-9]{5}$/.test(deviceCode)) {
    // 获取第一位字符
    const firstChar = deviceCode.charAt(0)
    // 检查第一位是否是大写字母
    if (firstChar >= "A" && firstChar <= "Z") {
      // 将字母转换为对应的数字（A=1, B=2, ..., Z=26）
      const letterCode = firstChar.charCodeAt(0) - "A".charCodeAt(0) + 1
      // 返回转换后的设备码
      return letterCode + deviceCode.slice(1)
    } else {
      // 第一位是数字，直接返回设备码
      return deviceCode
    }
  } else {
    return getRandomInt(100000, 999999)
  }
}
export default {
  private: {
    // 修改3：初始化空数组
    list: [],
    mostjieduan: 0,
    userName: "",
    // 新增：用户设备信息
    userBand: "unknown",
    enterPage: "rank",
    rank: "未获取",
    sure: false,
    hide: false,
    serial: 0,
    colorList: ["#FFC300", "#8A38F5", "#3662EC"],
    notice: ["暂无"],
    conn: null
  },
  backnotice() {
    this.enterPage = "rank"
  },
  notice1() {
    this.enterPage = "notice"
  },
  // enterUserName() {
  //   this.enterPage = "setname"
  // },
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    // 获取设备信息
    storage.get({
      key: "serial",
      success: (data) => {
        console.log(data)
        if (data) {
          this.serial = data
        } else {
          device.getSerial({
            success: (data) => {
              this.serial = convertDeviceCode(data.serial.slice(-6))
              storage.set({key: "serial", value: this.serial.toString()})
            },
            fail: () => {
              this.serial = "获取失败"
            }
          })
        }
      },
      fail: () => {}
    })
    this.load()
    this.conn = interconnect.instance()
    var conn = this.conn
    conn.onmessage = (data) => {
      prompt.showToast({message: "获取成功"})
      data = JSON.parse(data.data)
      this.list = data.leaderboard
      this.rank = data.message
      this.notice = data.notice
      this.saveList()
      console.log(`received message: ${data.data}`)
    }
  },
  ondelete() {
    this.userName = this.userName.slice(0, -1)
  },
  oncomplete(evt) {
    this.userName += evt.detail.content
  },
  exit(e) {
    if (e.direction == "left") {
      router.push({uri: "/pages/index"})
    }
  },
  load() {
    device.getInfo({
      success: function (ret) {
        console.log(`handling success, brand = ${ret.product}`)
        this.userBand = ret.product
        console.log(this.userBand)
      }
    })
    storage.get({
      key: "notice",
      success: (data) => {
        if (data) {
          this.notice = JSON.parse(data)
        } else {
          this.notice = ["暂无"]
        }
      }
    }),
      storage.get({
        key: "list",
        success: (data) => {
          if (data) {
            const storedData = JSON.parse(data)

            // 修改4：兼容旧数据结构
            if (Array.isArray(storedData)) {
              // 新格式：直接使用数组
              this.list = storedData
            } else {
              // 旧格式：转换为新格式
              this.list = Object.keys(storedData).map((userName) => ({
                userName,
                serial: this.serial,
                band: this.userBand,
                score: storedData[userName],
                time: "none"
              }))
            }
            console.log(storedData)
          }
        }
      })

    storage.get({
      key: "mostjieduan",
      success: (resca) => {
        this.mostjieduan = resca ? parseInt(resca, 10) : 1
      }
    })

    storage.get({
      key: "rank",
      success: (data) => {
        if (data) this.rank = JSON.parse(data)
      }
    })

    storage.get({
      key: "userName",
      success: (data) => {
        if (data) {
          this.userName = JSON.parse(data)
          if (/^\d+$/.test(this.userName)) this.enterPage = "setname"
        } else {
          this.enterPage = "setname"
        }
      }
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({uri: "/pages/index_maoxian_nostop"})
    }
  },
  back() {
    router.push({uri: "/pages/index_maoxian_nostop"})
    router.clear()
  },
  check() {
    this.getListFromServer(this)
  },
  getListFromServer(that) {
    device.getInfo({
      success: (ret) => {
        console.log(`handling success, brand = ${ret.product}`)
        this.userBand = ret.product
        const postData = {
          userName: this.userName,
          serial: this.serial, // 生成唯一ID
          score: this.mostjieduan,
          band: this.userBand,
          time: new Date().getTime(),
          version: "3.5"
        }
        console.log(postData)
        device.getInfo({
          success: function (ret) {
            console.log(`handling success, brand = ${ret.product}`)
            this.devicex = ret.product
            console.log(this.devicex)
            if (
              this.devicex != "Xiaomi Smart Band 8 Pro" &&
              this.devicex != "Xiaomi Smart Band 9" &&
              this.devicex != "REDMI Watch 4" &&
              this.devicex != "Xiaomi Smart Band 10"
            ) {
              const fetchOptions = {
                url: `http://rank.easejun.cn/leaderBoard/furinabetter/getList.php`,
                method: "POST", // 设置请求方法为 POST
                header: {
                  "Content-Type": "application/json" // 设置请求头，指定数据类型为 JSON
                },
                data: postData, // 发送的数据
                responseType: "json", // 期望响应类型为 JSON
                success: (res) => {
                  console.log("获取数据成功:", res)
                  if (res.code == 200) {
                    prompt.showToast({message: "获取成功"})
                    that.list = res.data.leaderboard
                    that.rank = res.data.message
                    that.notice = res.data.notice || "暂无公告"
                    that.saveList()
                    console.log(that.notice)
                  }
                },
                fail: (error, code) => {
                  console.error("获取失败:", error, "错误代码:", code)
                  prompt.showToast({
                    message: `获取失败，请检查小米运动健康连接${code}`,
                    duration: 2000
                  })
                },
                complete: () => {
                  console.log("请求结束")
                }
              }

              // 调用 fetch 方法进行网络请求
              fetch.fetch(fetchOptions)
            } else {
              var conn = interconnect.instance()
              conn.send({
                data: postData,
                success: () => {
                  console.log(`handling success`)
                  prompt.showToast({message: "成功,请在同步器上单击获取排行榜"})
                },
                fail: (data) => {
                  prompt.showToast({message: "失败,请在论坛下载同步器"})
                }
              })
            }
          }
        })
      }
    })
  },

  saveList() {
    storage.set({
      key: "list",
      value: JSON.stringify(this.list) // 直接存储数组
    })
    storage.set({
      key: "rank",
      value: JSON.stringify(this.rank)
    })
    storage.set({
      key: "notice",
      value: JSON.stringify(this.notice)
    })
  },
  enter() {
    if (!this.userName) {
      prompt.showToast({message: "用户名不能为空"})
      return
    }

    if (this.userName.length > 10) {
      prompt.showToast({message: "用户名超过10个字符"})
      return
    }

    if (/^\d+$/.test(this.userName)) {
      prompt.showToast({message: "用户名不能全为数字"})
      return
    }

    if (!this.sure) {
      prompt.showToast({message: "请再次点击确认用户名"})
      this.sure = true
      return
    }

    this.saveUserName()
  },
  saveUserName() {
    storage.set({
      key: "userName",
      value: JSON.stringify(this.userName),
      success: () => {
        this.enterPage = "rank"
        // 获取排行榜数据
        this.check()
      }
    })
  }
}
</script>

<style>
.bg {
  position: absolute;
  background-color: #000000;
}
.page {
  position: absolute;
  background-color: #000000;
  width: 100%;
  height: 100%;
}
.scroll {
  position: absolute;
  flex-wrap: wrap;
  align-content: flex-start;
  flex-direction: row;
  top: 80px;
  height: 320px;
  bottom: 0;
  left: 0;
  right: 0;
}
.title {
  position: absolute;
  color: white;
  background-color: #000000;
  font-weight: bold;
  font-size: 32px;
  top: 0px;
  width: 100%;
  height: 80px;
  text-align: center;
}
.rank {
  border-width: 3px;
  border-color: rgba(255, 255, 255, 0.06);
  width: 100%;
  height: 130px;
  margin-bottom: 5px;
  border-radius: 27px;
  background-color: #262626;
}
.rank-text {
  font-size: 24px;
  font-weight: bold;
  flex-wrap: wrap;
}
.user {
  position: absolute;
  top: 400px;
  width: 100%;
  height: 80px;
  text-align: center;
  color: white;
  font-weight: bold;
  font-size: 30px;
}
.column {
  /* 竖直 */
  flex-direction: column;
}
</style>
