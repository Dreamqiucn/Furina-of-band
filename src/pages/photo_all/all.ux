<script>
// 导入模块
import router from "@system.router"

export default {
  private: {
    img: "",
    which: "",
    whichtext: "",
    whichmore: ""
  },
  onInit() {
    if (this.which === "纠缠之缘") {
      this.img = "/common/icon/ball.png"
      this.whichtext =
        "听说每天签到会给10个，确实挺不错的，听说还可以用此获得芙宁娜最喜欢的小蛋糕？！！"
      this.whichmore = "太好玩了"
    } else if (this.which === "《清涟》CD") {
      this.img = "/common/icon/cd.jpg"
      this.whichtext = "芙宁娜送给你的礼物见面礼，她的作品《清涟》的CD"
      this.whichmore = "太好听了"
    } else if (this.which === "小蛋糕") {
      this.img = "/common/icon/cake.png"
      this.whichtext = "普茹斯蒂司，芙宁娜最喜欢的小蛋糕，给芙宁娜吃小蛋糕可以增加对她的好感度"
      this.whichmore = "太好吃了"
    } else if (this.which === "致水神") {
      this.img = "/common/icon/uncake.png"
      this.whichtext = "致水神，不过虽然叫致水神，但是芙宁娜认为不如普茹斯蒂司好吃。"
      this.whichmore = "好吃"
    } else if (this.which === "枫达饮料") {
      this.img = "/common/icon/juice.png"
      this.whichtext = "枫丹的特产饮料，芙宁娜最喜欢喝了，喝起来味道和芬达差不多？"
      this.whichmore = "太好喝了"
    } else if (this.which === "眼泪") {
      this.img = "/common/icon/water.png"
      this.whichtext = "不知是那一次芙宁娜哭的时候掉的眼泪，好像是被仆人欺负的那一次。"
      this.whichmore = "太珍贵了"
    } else if (this.which === "腿环") {
      this.img = "/common/icon/th.png"
      this.whichtext = "好好看，一定要珍藏起来。"
      this.whichmore = "太好看了！！！"
    } else if (this.which === "头发") {
      this.img = "/common/icon/hair.png"
      this.whichtext = "芙宁娜的头发，羊毛卷，作者最喜欢的发型！！！！！！！！"
      this.whichmore = "太好看了！！！"
    } else if (this.which === "轻小说") {
      this.img = "/common/icon/novel.png"
      this.whichtext =
        "芙宁娜最喜欢的轻小说，《转生之我成为雷电将军然后天下无敌》，与稻妻建交时八重神子送过来的礼物。"
      this.whichmore =
        "太人生有时候就是这样。爸妈总说要明辨是非，衡量好坏，但现实永远是在两个坏的选项中选出不那么坏的那一个。 女朋友已经决定和我分手了，她还告诉我的上级说我有赌瘾，现在工作也没了。我可没闲钱去做这种空虚的事，要是不交保护费，我爸妈的安全就难说了。然后他们骂我没出息，不干正事，也不存钱。 我是为了谁啊……我也没做错什么吧。 要说错的话，大概就是错在努力也活不下去，想了结自己，还没这个胆子。算了，等他们来了赶紧交钱。交完钱还得想想怎么赚摩拉，不然只能吃海草了。来，不如我们再做一个两坏之中选其轻的选择吧。 被一刀砍翻，或者被什么飞来的石头砸得脑袋开花，哪个会痛快些呢？ 「嗞嗞嗞——」从刚刚开始就有奇怪的声音，怎么回事…… 不会是要打雷吧？ …… 醒来的时候已经不知道过了多久。我只记得失去意识之前，好像瞬间被某种尖锐的东西贯通了全身。 「好像，不怎么痛……啊？！」我被吓得叫出了声。 这是我的声音吗？ 「啊，啊——」 居然是真的。我抬起手臂，华丽的布料之下是无比白皙的肌肤。 这显然不是我的身体，但一时间我的大脑并没有跳跃到那个显而易见的答案。 因为太不可思议了。我尝试站起来，这才完整地目睹了这套衣服的样子。每一个细节都无比华贵，只有至高无上的人才有福消受。 难道说……「怎么不是那小子……嗯？雷、雷电将军？」 掷地有声的称呼。 对啊。 我好像成为雷电将军了。收保护费的海乱鬼们列阵排开，虽然看不到他们的脸，但看动作就充满了戒备，还有些畏惧。这可是我从来都没见过的样子。 「兄弟们，报、报仇的机会到了……」声音很明显地由大变小，他害怕了。不愿在小弟面前丢脸，就这么逃掉可不行，但他也早就想到了战斗的结果。人数在逐渐变多，十人，二十人，五十人…… 可能觉得能用人数弥补力量上的劣势吧。但雷电将军的力量，岂会和凡人放置在同一天平之上？ 「就用你们，试试刀吧。」屏气，凝神，摆好架势。 命运即将改变，在这一刀之后。 「无想……」 …… 等等。「无想的一刀」，要怎么用来着？"
    } else if (this.which === "小米手环") {
      this.img = "/common/icon/xiaomi.png"
      this.whichtext = "芙宁娜的家？我喜欢！"
      this.whichmore = "太好用了"
    } else if (this.which === "小帽子") {
      this.img = "/common/icon/mz.png"
      this.whichtext = "好看的小帽子，太可爱了。"
      this.whichmore = "太好看了"
    } else if (this.which === "袜子") {
      this.img = "/common/icon/foot.png"
      this.whichtext = "棉白袜包裹着芙宁娜的玉足，脚趾晶莹剔透,Delicious"
      this.whichmore = "太好吃了！！！"
    } else if (this.which === "鞋子") {
      this.img = "/common/icon/xz.png"
      this.whichtext = "Delicious"
      this.whichmore = "太好吃了！！！"
    } else if (this.which === "神之眼") {
      this.img = "/common/icon/god.png"
      this.whichtext = "芙宁娜的神之眼，在表演完舞台剧后偶然间获得。"
      this.whichmore = "太珍贵了"
    } else if (this.which === "鸣神·离岛") {
      this.img = "/common/icon/dq1.png"
    } else if (this.which === "远眺踏鞴之岛") {
      this.img = "/common/icon/dq2.png"
    } else if (this.which === "千船万商云集之地") {
      this.img = "/common/icon/ly1.png"
    } else if (this.which === "玉京台") {
      this.img = "/common/icon/ly2.png"
    } else if (this.which === "西风大教堂") {
      this.img = "/common/icon/md1.png"
    } else if (this.which === "风之城") {
      this.img = "/common/icon/md2.png"
    } else if (this.which === "一切智慧具足之城") {
      this.img = "/common/icon/xmxm1.png"
    } else if (this.which === "双树控扼的港湾") {
      this.img = "/common/icon/xmxm2.png"
    } else if (this.which === "伊黎耶的旋舞") {
      this.img = "/common/icon/fd1.png"
    } else if (this.which === "于秋分山远眺") {
      this.img = "/common/icon/fd2.png"
    } else if (this.which === "甜甜花") {
      this.img = "/common/icon/flower.png"
      this.whichtext = "随处可见的花朵，可以做成美食。"
      this.whichmore = "太好采了"
    } else if (this.which === "甜甜花酿鸡") {
      this.img = "/common/icon/jfood.png"
      this.whichtext = "吃一个可以回复1000血量，其实挺不错的。"
      this.whichmore = "太好吃了"
    } else if (this.which === "骗骗花") {
      this.img = "/common/icon/flowerflower.png"
      this.whichtext = "在探索的时候有几率遇到，从地底下钻出来了，但可以获得不少材料，太可恶了。"
      this.whichmore = "太可恶了"
    } else if (this.which === "野猪") {
      this.img = "/common/icon/pig.png"
      this.whichtext = "在探索的时候有几率遇到，把芙宁娜撞晕了，但可以获得不少材料。"
      this.whichmore = "太可恶了"
