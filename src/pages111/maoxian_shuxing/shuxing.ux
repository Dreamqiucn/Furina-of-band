    })
    storage.get({
        key: "aka",
            success: (resca) => {
                this.aka = resca ? parseInt(resca, 10) : 484
              storage.set({
                key: "aka",
                value: this.aka.toString()
              })
            
            }
    })
    storage.get({
        key: "akq",
            success: (resca) => {
                this.akq = resca ? parseInt(resca, 10) : 1358
              storage.set({
                key: "akq",
                value: this.akq.toString()
              })
            
            }})
      storage.get({
      key: "ake",
      success: (resca) => {
          this.ake = resca ? parseInt(resca, 10) : 936
          this.upblood=Math.round(this.ake/3)
          storage.set({
              key: "ake",
              value: this.ake.toString()
          })
      }})
    storage.get({
      key: "cake",
      success: (resca) => {
        this.cake = resca ? parseInt(resca, 10) : 0
      }
    })
    storage.get({
      key: "live",
      success: (resca) => {
        this.live = resca ? parseInt(resca, 10) : 1
        if (this.live === 1) {
          this.see = false
        }else if (this.live === 0) {
          this.see = true
        }
        
      }

    })},
    toHomePage(eve) {
      if (eve.direction === 'right') {
            router.back()

      }
    }
  ,
back() {
   router.back()
}}
</script>
