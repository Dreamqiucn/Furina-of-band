<template>
  <div class="page column center" @swipe="toHomePage">
    <div class="header column center">
      <div class="column center">
        <text class="a">武器池</text>
        <text onclick="changzhu" class="e">常驻池</text>
        <text onclick="juese" class="e">角色池</text>
      </div>
      <text class="b">原石数目：{{ stone }}</text>
      <text class="b">五星保底：{{ wx }}/90 四星保底：{{ fourStarPity }}/10</text>
      <text class="b" onclick="idea">介绍</text>
    </div>
    <div class="body column center">
      <image class="icon" src="/common/icon/ball.png"></image>
    </div>
    <div class="footer column center">
      <div style="margin-top: 10px" class="row center">
        <input
          class="but"
          type="button"
          value="单抽"
          style="font-size: 30px; color: #ffffff"
          onclick="handleButtonClick"
        />
        <input
          class="but"
          type="button"
          value="十连"
          style="font-size: 30px; color: #ffffff"
          onclick="ten"
        />
      </div>
    </div>
    <image class="back" src="/common/icon/back.png" onclick="back"></image>
  </div>
</template>

<style>
.back {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
  opacity: 0.5;
  z-index: 1000;
}

.but {
  width: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30px;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.center {
  align-items: center;
  justify-content: center;
}

.header {
  margin-top: 20px;
}

.page {
  justify-content: center;

  background-color: #000000;
  flex: 1;
}

.body {
  margin-top: 10px;
}

.footer {
  margin-top: 10px;
}

.icon {
  width: 156px;
  height: 156px;
}

.a {
  font-size: 25px;
}

.b {
  font-size: 20px;
  color: #d1c5c5;
}

.e {
  font-size: 25px;
  color: #c9c9c9;
}
</style>

<script>
// 导入模块
import router, {replace} from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

// 数值校验函数
const safeNumber = (value, defaultValue = 0) => {
  const num = Number(value)
  return isNaN(num) ? defaultValue : num
}

export default {
  public: {
    today: 0,
    lastdayb: 0,
    wx: null, // 五星保底计数器
    stone: 0,
    adjustedAa: 0,
    fourStarPity: 0 // 四星保底计数器
  },
  idea() {
    router.push({
      uri: "/pages/index_ideaall",
      params: {
        rule: "武器池需要原石换成纠缠之缘抽取，常驻池可以自定义获得相遇之缘。（原石通过无尽模式每关可获得20）\n概率公布：\n当已抽数小于75时，五星概率为0.6%；当大于等于75时，每抽数五星概率增加6%。四星概率恒为5%"
      }
    })
  },
  ten() {
    if (this.stone < 1600) {
      prompt.showToast({message: "原石不足"})
    } else {
      this.stone -= 1600
      storage.set({
        key: "stone",
        value: this.stone.toString()
      })
      router.push({uri: "/pages/ball_gan_ten"})
    }
  },
  changzhu() {
    router.push({uri: "/pages/index_ball"})
  },
  juese() {
    router.push({uri: "/pages/index_ball_her"})
  },
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.push({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.push({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })

    // 增强版初始化存储（新增NaN处理）
    const initStorage = (key, defaultValue) => {
      storage.get({
        key,
        success: (res) => {
          let value = safeNumber(res, defaultValue)
          this[key] = value
          // 如果存储值异常，强制修正（新增）
          if (res && safeNumber(res) !== value) {
            storage.set({key, value: value.toString()})
          }
        },
        fail: () => {
          // 新增容错处理
          this[key] = defaultValue
          storage.set({key, value: defaultValue.toString()})
        }
      })
    }

    initStorage("stone", 0)
    initStorage("wx", 0)
    initStorage("fourStarPity", 0)
  },

  // 四星保底逻辑（增加类型校验）
  async checkFourStarPity() {
    // 强制转换为数字（新增安全处理）
    this.wx = safeNumber(this.wx)
    this.fourStarPity = safeNumber(this.fourStarPity)

    let gotHighRarity = false
    const randomNumber = Math.floor(Math.random() * 1000) + 1
    const wxRate = this.getwxRate()

    // 保底触发逻辑
    if (this.fourStarPity >= 9) {
      gotHighRarity = true
      router[randomNumber < wxRate ? "push" : "push"]({
        uri: randomNumber < wxRate ? "/pages/ball_gan_gold" : "/pages/ball_gan"
      })
    }
    // 正常概率（增加范围校验）
    else {
      if (randomNumber < wxRate) {
        gotHighRarity = true
        router.push({uri: "/pages/ball_gan_gold"})
      } else if (randomNumber < wxRate + 50) {
        gotHighRarity = true
        router.push({uri: "/pages/ball_gan"})
      } else {
        router.push({
          uri: "/pages/ball_one",
          params: {
            pink: 1
          }
        })
      }
    }

    await this.updatePityCounter(gotHighRarity)
  },

  // 概率计算（增加参数校验）
  getwxRate() {
    const currentWx = safeNumber(this.wx)
    if (currentWx >= 88) return 1000
    if (currentWx >= 74) return 6 + (currentWx - 74) * 60
    return 6
  },

  // 更新计数器（增加数值安全）
  async updatePityCounter(gotHighRarity) {
    try {
      this.fourStarPity = gotHighRarity ? 0 : Math.min(safeNumber(this.fourStarPity) + 1, 10)

      await storage.set({
        key: "fourStarPity", // 注意：原始代码此处拼写错误，建议修正为"fourStarPity"
        value: this.fourStarPity.toString()
      })
    } catch (e) {
      console.error("计数器更新失败:", e)
    }
  },

  // 抽卡入口（强化校验逻辑）
  async handleButtonClick() {
    try {
      // 强制数值有效（新增三重校验）
      this.stone = safeNumber(this.stone, 11000)
      this.wx = safeNumber(this.wx)
      this.fourStarPity = safeNumber(this.fourStarPity)

      if (this.stone < 160) {
        prompt.showToast({message: "原石不足"})
        return
      }

      // 原子操作：计数器+1
      this.wx = Math.min(safeNumber(this.wx) + 1, 90)
      await storage.set({
        key: "wx",
        value: this.wx.toString()
      })

      // 原子操作：扣除石头
      this.stone = Math.max(0, this.stone - 160)
      await storage.set({
        key: "stone",
        value: this.stone.toString()
      })

      await this.checkFourStarPity()
    } catch (error) {
      console.error("抽卡异常:", error)
      prompt.showToast({
        message: "っ °Д °;)っ 抽卡过程出现异常！"
      })
    }
  },

  back() {
    router.push({uri: "/pages/index"})
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.back()
    }
  }
}
</script>
