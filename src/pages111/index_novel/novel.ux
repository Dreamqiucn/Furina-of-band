    })
  },
  haira() {
    if (this.level < 70) return
    router.push({
      uri: "/pages/novel_person",
      params: {which: "第八章", __PARAM_LAUNCH_FLAG___: "clearTask"}
    })
  },
  novela() {
    if (this.level < 80) return
    router.push({
      uri: "/pages/novel_person",
      params: {which: "第九章", __PARAM_LAUNCH_FLAG___: "clearTask"}
    })
  },
  md() {
    if (this.level < 120) return
