<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page" style="flex-direction: column" onclick="toHomePage">
    <text class="text">{{ textValue }}_</text>
    <input-method
      hide="{{ hide }}"
      keyboardtype="{{ keyboardtype }}"
      maxlength="5"
      screentype="{{ screentype }}"
      @visibility-change="onVisibilityChange"
      @key-down="onKeyDown"
      @delete="onDelete"
      @complete="onComplete"
    ></input-method>
    <image class="about" src="/common/icon/back.png" onclick="back"></image>

    <image if="textValue.length>0" class="about1" src="/common/icon/yes.png" onclick="yes"></image>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"
const CODE_CONFIG = [
  {
    code: "3.6codefurina",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "vipfordreamqiu768",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "vip7code1",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "7code2forvip",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "8vipcode1",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "8forcode2vip",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "truelovevip",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "dev666",
    validDate: null,
    isSingleUse: false,
    message: "已获得1600原石"
  },
  {
    code: "羊毛卷",
    validDate: null,
    isSingleUse: false,
    message: "已获得1600原石"
  },
  {
    code: "9ecodevipsecond",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "9fristcode",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "viptencode1",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "tencode2forvip",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "vip11code1",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "11code2forvip",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "12vipcode1",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "12forcode2vip",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "1codevipsecond",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "1fristcode",

    validDate: null,

    isSingleUse: true,

    message: "已获得1600原石"
  },
  {
    code: "dev123",

    validDate: null,

    isSingleUse: false,

    message: "已获得1600原石"
  }
]

export default {
  private: {
    textValue: "",
    hide: false,
    keyboardtype: "QWERTY",
    vibratemode: "short",
    screentype: "pill-shaped",
    codeConfig: CODE_CONFIG
  },
  info() {
    prompt.showToast({
      message:
        "兑换码可以通过加入爱发电电圈或加入QQ频道获得，爱发电电圈每两周发一次。在QQ频道节日附近时会发放兑换码，节日的兑换码只有在当天可用。本次版本更新兑换码【3.3codefurina】",
      duration: 3000
    })
  },
  onVisibilityChange(evt) {
    this.hide = evt.detail.hide
    console.log("显示状态变更:" + JSON.stringify(evt))
  },
  onKeyDown(evt) {
    //this.textValue += evt.detail.content;
    console.log("按下按键:" + JSON.stringify(evt))
  },
  onDelete() {
    this.textValue = this.textValue.slice(0, -1)
    console.log("删除字符")
  },
  changeState() {
    this.hide = !this.hide
  },
  onComplete(evt) {
    this.textValue += evt.detail.content
    console.log("返回字符:" + JSON.stringify(evt))
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index"
    })
  },

  yes() {
    const enteredCode = this.textValue.trim()
    if (!enteredCode) {
      prompt.showToast({message: "请输入有效的兑换码", duration: 1000})
      return
    }

    // 查找匹配的兑换码配置
    const matchedCode = this.codeConfig.find((c) => c.code === enteredCode)
    if (!matchedCode) {
      prompt.showToast({message: "无效的兑换码", duration: 1000})
      return
    }

    // 日期有效性验证
    if (matchedCode.validDate) {
      const now = new Date()
      const isValidDate =
        now.getMonth() + 1 === matchedCode.validDate.month &&
        now.getDate() === matchedCode.validDate.day

      if (!isValidDate) {
        prompt.showToast({message: "当前不在有效期内", duration: 1000})
        return
      }
    }

    // 使用记录检查
    storage.get({
      key: "usedCodes",
      success: (data) => {
        const usedCodes = data ? JSON.parse(data) : []

        if (matchedCode.isSingleUse && usedCodes.includes(enteredCode)) {
          prompt.showToast({message: "该兑换码已被使用", duration: 1000})
          return
        }

        // 执行兑换操作
        const updateCodes = matchedCode.isSingleUse ? [...usedCodes, enteredCode] : usedCodes

        storage.set({
          key: "usedCodes",
          value: JSON.stringify(updateCodes),
          success: () => {
            prompt.showToast({message: matchedCode.message, duration: 1000})
            storage.get({
              key: "stone",
              success: (data) => {
                const stone = data ? JSON.parse(data) : 0
                const newStone = stone + 1600
                storage.set({
                  key: "stone",
                  value: JSON.stringify(newStone)
                })
              }
            })
          },
          fail: () => {
            prompt.showToast({message: "兑换失败，请重试", duration: 1000})
          }
        })
      },
      fail: () => {
        prompt.showToast({message: "存储读取失败", duration: 1000})
      }
    })
  }
}
</script>

<style>
