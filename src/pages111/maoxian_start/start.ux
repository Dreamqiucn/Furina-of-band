    </div>
    <div class="body column center">
      <text class="b">你遇到了{{ realmonster }}</text>
    </div>
    <div class="footer column center">
      <div style="margin-top: 10px" class="column center">
        <text class="b">剩余{{ timeLeft }}秒自动前往界面</text>
        <text class="b">提示：</text>
        <text class="b">无尽模式不能退出</text>
        <text class="b" style="margin-top: 10px">
          {{ remind }}
        </text>
        <input
          class="but"
          type="button"
          value="立刻前往"
          style="font-size: 30px; color: #ffffff"
          onclick="gonow"
        />
      </div>
    </div>
  </div>
</template>

<style>
.back {
  position: absolute;
  left: 6px;
