      },{
        name: "兑换无尽材料",
        iconSrc: "/common/icon/ff.png",
        Src: "兑换无尽材料"
      }
    ]
  },
  
  handleClick() {
    app.terminate()
  },
  navigateToPage(Src) {
    router.push({
      uri: "/pages/maoxian_gan_more",
      params: {
        which: Src
      }
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
          router.back()

    }
  },
  back() {
        router.back()

  }
}
</script>
