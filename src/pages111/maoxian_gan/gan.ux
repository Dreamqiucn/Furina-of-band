<script>
// 导入模块
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

export default {
  public: {
    gan1: 0,
    gan2: 0,
    realgan: 0
  },
  gana() {
    if (this.gan1 === 1) {
      storage.get({
        key: "realgan",
        success: (resca) => {
          this.realgan = resca ? parseInt(resca, 10) : 0
          storage.set({
            key: "realgan",
            value: "1"
          })
        }
      })
    } else {
      prompt.showToast({
        message: "你尚未拥有此武器，请通过祈愿获得",
        duration: 2000
      })
    }
  },
  ganb() {
    if (this.gan2 === 1) {
      storage.get({
        key: "gan",
        success: (resca) => {
          this.gan = resca ? parseInt(resca, 10) : 0
          storage.set({
            key: "gan",
            value: "2"
          })
        }
      })
    } else {
      prompt.showToast({
        message: "你尚未拥有此武器，请通过祈愿获得",
        duration: 2000
      })
    }
  },
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    storage.get({
      key: "gan1",
      success: (res) => {
        this.gan1 = res ? parseInt(res, 10) : 0
      }
    })
    storage.get({
      key: "gan2",
      success: (res) => {
        this.gan2 = res ? parseInt(res, 10) : 0
      }
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index"
    })
  },
  bing() {
    router.replace({
      uri: "/pages/maoxian_ice"
    })
  },
  jing() {
    router.replace({
      uri: "/pages/maoxian_jing"
    })
  },
  qqw() {
    router.replace({
      uri: "/pages/maoxian_qqw"
    })
  },
  water() {
    router.replace({
      uri: "/pages/maoxian_waterren"
    })
  }
}
</script>
