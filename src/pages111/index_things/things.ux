        })
        storage.get({
          key: "nsjf",
          success: (result) => (this.nsjf = result ? parseInt(result, 10) : 0)
        })
        this.jys += 5
        this.nsjf += 5
        storage.set({
          key: "jys",
          value: this.jys.toString()
        })
        storage.set({
          key: "nsjf",
          value: this.nsjf.toString()
        })
        prompt.showToast({
          message: "芙芙今天太想进步了，天赋书增加5个",
          duration: 2000
        })
        break
      case 7:
        storage.get({
          key: "cake",
          success: (result) => (this.cake = result ? parseInt(result, 10) : 0)
        })
        this.cake += 1
        storage.set({
          key: "cake",
          value: this.cake.toString()
        })
        prompt.showToast({
          message: "芙芙有点饿，小蛋糕加1个",
          duration: 2000
        })
        break
      case 8:
        storage.get({
          key: "uncake",
          success: (result) => (this.uncake = result ? parseInt(result, 10) : 0)
        })
        this.uncake += 10
        storage.set({
          key: "uncake",
          value: this.uncake.toString()
        })
        prompt.showToast({
          message: "芙芙有点饿，致水神加10个",
          duration: 2000
        })
        break
      case 9:
        storage.get({
          key: "blood",
          success: (result) => (this.blood = result ? parseInt(result, 10) : 0)
        })
        storage.get({
          key: "nsblood",
          success: (result) => (this.nsblood = result ? parseInt(result, 10) : 0)
        })
        this.blood += 1000
        this.nsblood += 1000
        storage.set({
          key: "blood",
          value: this.blood.toString()
        })
        storage.set({
          key: "nsblood",
          value: this.nsblood.toString()
        })
        prompt.showToast({
          message: "芙芙想变强，血量加1000",
          duration: 2000
        })
        break
      case 10:
        storage.get({
          key: "aka",
          success: (result) => (this.aka = result ? parseInt(result, 10) : 0)
        })
        storage.get({
          key: "ake",
          success: (result) => (this.ake = result ? parseInt(result, 10) : 0)
        })
        storage.get({
          key: "akq",
          success: (result) => (this.akq = result ? parseInt(result, 10) : 0)
        })
        storage.get({
          key: "nsaka",
          success: (result) => (this.nsaka = result ? parseInt(result, 10) : 0)
        })
        storage.get({
          key: "nsake",
          success: (result) => (this.nsake = result ? parseInt(result, 10) : 0)
        })
        storage.get({
          key: "nsakq",
          success: (result) => (this.nsakq = result ? parseInt(result, 10) : 0)
        })
        this.aka += 250
        this.ake += 350
        this.akq += 550
        this.nsaka += 250
        this.nsake += 350
        this.nsakq += 550
        storage.set({
          key: "aka",
          value: this.aka.toString()
        })
        storage.set({
          key: "ake",
          value: this.ake.toString()
        })
        storage.set({
          key: "akq",
          value: this.akq.toString()
        })
        storage.set({
          key: "nsaka",
          value: this.nsaka.toString()
        })
        storage.set({
          key: "nsake",
          value: this.nsake.toString()
        })
        storage.set({
          key: "nsakq",
          value: this.nsakq.toString()
        })
        prompt.showToast({
          message: "芙芙变强了,AEQ技能伤害提高",
          duration: 2000
        })
        break
      case 11:
        // 这里不需要获取任何数据，因为是页面跳转
        prompt.showToast({
          message: "芙芙有点像打架，于是去挑战了boss",
          duration: 2000
        })
        setTimeout(() => {
          const randomNumber1 = Math.floor(Math.random() * 4) + 1
          switch (randomNumber1) {
            case 1:
              router.push({
                uri: "/pages/maoxian_putong",
                params: {
                  which: "无相之冰"
                }
              })
              break
            case 2:
              router.push({
                uri: "/pages/maoxian_putong",
                params: {
                  which: "无相之冰"
                }
              })
              break
            case 3:
              router.push({
                uri: "/pages/maoxian_putong",
                params: {
                  which: "无相之冰"
                }
              })
              break
            case 4:
              router.push({
                uri: "/pages/maoxian_putong",
                params: {
                  which: "纯水精灵"
                }
              })
              break
          }
        }, 2000)
        break
      case 12:
        storage.get({
          key: "cishu",
          success: (result) => (this.cishu = result ? parseInt(result, 10) : 0)
        })
        this.cishu += 3
        storage.set({
          key: "cishu",
          value: this.cishu.toString()
        })
        prompt.showToast({
          message: "芙宁娜想冒险，今日冒险次数加3",
          duration: 2000
