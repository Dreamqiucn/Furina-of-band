<template>
  <div class="page download-page" @swipe="toHomePage">
    <div class="header column center">
      <text>结果</text>
    </div>
    <div class="column center body">
      <div class="center row">
        <image class="icon2" src="/common/icon/flower.png"></image>
        <image class="icon2" src="/common/icon/j.png"></image>
      </div>
      <div class="item">
        <text>获得x {{ food }}</text>
      </div>
    </div>

    <image class="back" src="/common/icon/back.png" onclick="back"></image>
  </div>
</template>
<style>
.back {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
}

.body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.item {
  display: flex;
  justify-content: flex-end;
  /* 向右对齐 */
  align-items: center;
}

.info {
  /* 一块区域 */
  width: 335px;
  flex: 1;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.info {
  /* 一块区域 */
  width: 272px;
  margin-top: 0px;
}

.center {
  align-items: center;
  justify-content: center;
}

.header {
  margin-top: 20px;
}

.page {
  background-color: #000000;
  width: 192px;
  height: 480px;
}

.icon2 {
  width: 60px;
  height: 60px;
}
</style>
<script>
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"
export default {
  public: {
    thing: "",
    food: 6,
    food1: 0
  },
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    storage.get({
      key: "food",
      success: (rescDD) => {
        this.food1 = rescDD ? parseInt(rescDD, 10) : 0
        this.food1 += 6
        storage.set({
          key: "food",
          value: this.food1.toString() // 确保存储为字符串
        })
      }
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index_explore"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index_explore"
    })
  }
}
</script>
