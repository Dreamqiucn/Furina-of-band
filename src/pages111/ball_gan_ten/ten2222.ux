<template>
  <div class="page download-page column">
    <!-- 初始状态 -->
    <div if="{{ !showResults }}">
      <image
        onclick="startTenPull"
        class="result-bg"
        src="{{ has5Star ? '/common/icon/gold.png' : '/common/icon/zi.png' }}"
      ></image>
    </div>

    <!-- 结果展示 -->
    <div if="{{ showResults }}" class="column">
      <div class="result-header">
        <text class="result-title">十连结果</text>
        <text class="pity-counter">五星保底：{{ wuxing }}/90</text>
      </div>

      <div class="result-grid">
        <div for="{{ results }}" class="result-item column">
          <image class="icon2" src="{{ $item.icon }}"></image>
          <text class="item-name">{{ $item.name }}</text>
        </div>
      </div>
    </div>

    <image if="{{ showResults }}" class="back" src="/common/icon/back.png" onclick="back"></image>
  </div>
</template>
<script>
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"

const WEAPON_POOL = {
  // 5星
  5: [
    {key: "sky", name: "天空之刃", icon: "/common/icon/sky.png"},
    {key: "wolf", name: "狼的末路", icon: "/common/icon/wolf.png"}
  ],
  // 4星
  4: [
    {key: "jlj", name: "祭礼剑", icon: "/common/icon/jlj.png", star: 4},
    {key: "shuixian", name: "水仙十字剑", icon: "/common/icon/shuixian.png", star: 4},
    {key: "changjian", name: "船坞长剑", icon: "/common/icon/changjain.png", star: 4},
    {key: "huihe", name: "灰河渡手", icon: "/common/icon/huihe.png", star: 4}
  ],
  // 3星
  3: [{key: "cake", name: "小蛋糕", icon: "/common/icon/cake.png"}]
}

export default {
  public: {
    showResults: false,
    results: [],
    wuxing: 0,
    fourStarPity: 0,
    has5Star: false,
    currentCount: 0
  },

  // 动态五星概率
  getWuxingRate() {
    if (this.wuxing < 74) return 6 // 0.6%
    if (this.wuxing < 88) return 6 + (this.wuxing - 73) * 60
    return 1000 // 保底必出
  },

  async onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    try {
      const [wuxing, fourStarPity, inventory] = await Promise.all([
        this.getStorageValue("wuxing"),
        this.getStorageValue("fourStarPity"),
        this.getStorageValue("inventory", true)
      ])
      this.wuxing = wuxing || 0
      this.fourStarPity = fourStarPity || 0
      this.currentCount = inventory ? JSON.parse(inventory).length : 0
    } catch (error) {
      prompt.showToast({message: "加载数据失败"})
    }
  },

  async getStorageValue(key, isJson = false) {
    return new Promise((resolve) => {
      storage.get({
        key: key,
        success: (data) => {
          if (!data) return resolve(isJson ? {} : 0)
          resolve(isJson ? JSON.parse(data) : parseInt(data))
        }
      })
    })
  },

  async startTenPull() {
    try {
      this.showResults = true
      this.results = await this.generateTenPull()
      this.has5Star = this.results.some((i) => i.star === 5)
      await this.saveCounters()
    } catch (error) {
      prompt.showToast({message: "抽卡失败，请重试"})
    }
  },

  async generateTenPull() {
    let results = []
    let hasTriggered4Star = false

    for (let i = 0; i < 10; i++) {
      const {item} = await this.pullOnce()
      results.push(item)

      // 保底检测
      if (item.star >= 4) hasTriggered4Star = true
    }

    // 十连保底：至少1个4星
    if (!hasTriggered4Star) {
      results[9] = this.getRandomItem(4)
      this.fourStarPity = 0
    }

    // 更新库存
    await this.updateInventory(results)
    return results
  },

  async pullOnce() {
    let newWuxing = this.wuxing + 1
    let newFourStarPity = this.fourStarPity + 1
    let item

    const fiveStarRate = this.getWuxingRate()
    const fourStarRate = 50 // 固定5%四星概率

    // 保底优先级
    if (newWuxing >= 90) {
      // 硬保底
      item = this.getRandomItem(5)
      newWuxing = 0
    } else if (fiveStarRate >= 1000) {
      // 软保底
      item = this.getRandomItem(5)
      newWuxing = 0
    } else if (newFourStarPity >= 10) {
      // 四星保底
      item = this.getRandomItem(4)
      newFourStarPity = 0
    } else {
      const rand = Math.floor(Math.random() * 1000)
      if (rand < fiveStarRate) {
        // 五星
        item = this.getRandomItem(5)
        newWuxing = 0
      } else if (rand < fiveStarRate + fourStarRate) {
        // 四星
        item = this.getRandomItem(4)
        newFourStarPity = 0
      } else {
        // 三星（主要概率）
        item = this.getRandomItem(3)
      }
    }

    // 更新计数器
    this.wuxing = newWuxing
    this.fourStarPity = newFourStarPity

    return {item}
  },

  getRandomItem(star) {
    const pool = WEAPON_POOL[star]
    return {
      ...pool[Math.floor(Math.random() * pool.length)],
      star: star
    }
  },

  async updateInventory(item) {
    // 单独处理小蛋糕
    if (item.key === "cake") {
      return new Promise((resolve) => {
        storage.get({
          key: "cake",
          success: (data) => {
            const count = (data ? parseInt(data) : 0) + 1
            storage.set({
              key: "cake",
              value: count.toString(),
              success: () => {
                this.currentCount = count
                resolve()
              }
            })
          }
        })
      })
    }

    // 其他物品使用原有库存系统
    return new Promise((resolve) => {
      storage.get({
        key: "inventory",
        success: (data) => {
          const inventory = data ? JSON.parse(data) : {}
          inventory[item.key] = (inventory[item.key] || 0) + 1
          storage.set({
            key: "inventory",
            value: JSON.stringify(inventory),
            success: resolve
          })
        }
      })
    })
  },

  async saveCounters() {
    await Promise.all([
      storage.set({key: "wuxing", value: this.wuxing.toString()}),
      storage.set({key: "fourStarPity", value: this.fourStarPity.toString()})
    ])
  },

  back() {
    router.replace({uri: "pages/index_ball_pink"})
  }
}
</script>
<style>
.back {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
}

.info {
  /* 一块区域 */
  width: 335px;
  flex: 1;
}

.download-page {
  display: flex;
  flex-direction: column;

  height: 100%;
  position: absolute;
  width: 100%;
}

text {
  color: #ffffff;
}

.column {
  /* 竖直 */
  flex-direction: column;
}

.row {
  /* 水平 */
  flex-direction: row;
}

.info {
  /* 一块区域 */
  width: 100%;
  margin-top: 0px;
}

.center {
  align-items: center;
  justify-content: center;
}

.page {
  background-color: #000000;
  width: 100%;
  height: 480px;
  flex: 1;
}

.icon2 {
  width: 70px;
  height: auto;
}

.bg {
  width: 90%;
  height: 90%;
}

.result-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.result-item {
  width: 19%;
  background: rgba(0, 0, 0, 0.6);
  position: relative;
}

.item-icon {
  width: 30px;
  height: auto;
}

.item-name {
  font-size: 22px;

  padding: 2px;
  text-align: center;
  color: #ff3b3b;
  text-overflow: ellipsis;
}

.result-header {
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.result-title {
  font-size: 28px;
  color: #ffd700;
  margin-bottom: 8px;
}
</style>
