      [2460, [2420, 2460], [2170000000, 2480000000]],
      [2500, [2460, 2500], [2480000000, 2830000000]],
      [2540, [2500, 2540], [2830000000, 3230000000]],
      [2580, [2540, 2580], [3230000000, 3700000000]],
      [2620, [2580, 2620], [3700000000, 4230000000]],
      [2660, [2620, 2660], [4230000000, 4830000000]],
      [2700, [2660, 2700], [4830000000, 5520000000]],
