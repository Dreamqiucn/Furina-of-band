<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page" style="flex-direction: column">
    <input-method
      hide="{{ hide }}"
      keyboardtype="{{ keyboardtype }}"
      maxlength="5"
      screentype="{{ screentype }}"
      @visibility-change="onVisibilityChange"
      @key-down="onKeyDown"
      @delete="onDelete"
      @complete="onComplete"
    ></input-method>

    <image class="about" src="/common/icon/back.png" onclick="back"></image>

    <image if="textValue.length>0" class="about1" src="/common/icon/yes.png" onclick="yes"></image>
    <text class="text1" style="font-size: 25px">{{ question }}</text>
    <text class="a" style="font-size: 25px">{{ textValue }}_</text>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "../../common/storage.js"
import prompt from "@system.prompt"
const CODE_CONFIG = [
  {
    code: "3.2codefurina",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "vipfordreamqiu768",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "vipfor46code",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "vipsecond",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "truelovevip",
    validDate: null,
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "51劳动节万岁",
    validDate: {month: 5, day: 1},
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "codeduanwujie",
    validDate: {month: 5, day: 31},
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "thanksliuyuze61",
    validDate: {month: 6, day: 1},
    isSingleUse: true,
    message: "感谢liuyuze61！"
  },
  {
    code: "高考加油",
    validDate: {month: 6, day: 7},
    isSingleUse: true,
    message: "已获得1600原石"
  },
  {
    code: "dev123",
    validDate: null,
    isSingleUse: false,
    message: "已获得1600原石"
  },
  {
    code: "羊毛卷",
    validDate: null,
    isSingleUse: false,
    message: "已获得1600原石"
  }
]

export default {
  private: {
    textValue: "",
    hide: false,
    keyboardtype: "QWERTY",
    vibratemode: "short",
    screentype: "pill-shaped",
    codeConfig: CODE_CONFIG,
    question: "芙宁娜可爱吗?",
    id: 0,
    wt: []
  },
  info() {
    prompt.showToast({
      message: "请回答问题，输入正确的答案即可完成委托，答案可参考WIKI界面",
      duration: 3000
    })
  },
  onVisibilityChange(evt) {
    this.hide = evt.detail.hide
    console.log("显示状态变更:" + JSON.stringify(evt))
  },
  onKeyDown(evt) {
    //this.textValue += evt.detail.content;
    console.log("按下按键:" + JSON.stringify(evt))
  },
  onDelete() {
    this.textValue = this.textValue.slice(0, -1)
    console.log("删除字符")
  },
  changeState() {
    this.hide = !this.hide
  },
  onComplete(evt) {
    this.textValue += evt.detail.content
    console.log("返回字符:" + JSON.stringify(evt))
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  },
  back() {
    router.replace({
      uri: "/pages/index_need"
    })
  },
  onInit() {
    storage.get({
      key: "index",
      success: (data) => {
        this.aaa = data
      }
    })
    storage.get({
      key: "rpg",
      success: (data) => {
        console.log(data)
        if (data == 721 || this.aaa == "1234567890") {
          console.log("successful")
        } else if (data == "") {
          console.log("无设备码")
          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        } else {
          console.log("有设备码没验证")

          prompt.showToast({
            message: "盗版死妈操你妈",
            duration: 1000
          })
          router.replace({
            uri: "pages/lock"
          })
        }
      },
      fail: () => {}
    })
    console.log(this.id)
    storage.get({
      key: "wt",
      success: (res) => {
        this.wt = JSON.parse(res)
      }
    })
    console.log("wwwwwwwwwwww" + this.wt)
    console.log("id" + this.id)
    if (this.question === "芙宁娜可爱吗") {
      this.answer = "可爱"
    } else if (this.question === "芙宁娜是哪个国家的“神”") {
      this.answer = "枫丹"
    } else if (this.question === "芙宁娜是人还是神") {
      this.answer = "人"
    } else if (this.question === "芙宁娜的武器是什么类型的") {
      this.answer = "单手剑"
    } else if (this.question === "芙宁娜的两个形态名（填两个字）") {
      this.answer = "荒芒"
    } else if (this.question === "芙宁娜最喜欢的小蛋糕叫什么") {
      this.answer = "普茹斯蒂司"
    } else if (this.question === "芙宁娜什么版本上线的原神") {
      this.answer = "4.2"
    } else if (this.question === "真正的水神叫什么") {
      this.answer = "芙卡洛斯"
    } else if (this.question === "芙宁娜第一个命座名（一句话）") {
      this.answer = "爱是难驯鸟，哀乞亦无用"
    } else if (this.question === "芙宁娜生日是什么时候（x月x日）") {
      this.answer = "10月13日"
    } else if (this.question === "芙宁娜命座名（一个词语）") {
      this.answer = "司颂座"
    } else if (this.question === "芙宁娜升级采集材料") {
      this.answer = "湖光铃兰"
    } else if (this.question === "芙宁娜E技能名称") {
      this.answer = "孤心沙龙"
    } else if (this.question === "芙宁娜的配音演员是谁（中文）") {
      this.answer = "钱琛"
    } else if (this.question === "芙宁娜的普通攻击名称") {
      this.answer = "独舞之邀"
    } else if (this.question === "芙宁娜的称号是什么") {
      this.answer = "不休独舞"
    } else if (this.question === "芙宁娜的专武是什么") {
      this.answer = "静水流涌之辉"
    }
  },
  yes() {
    if (this.answer === this.textValue) {
      this.wt[this.id].finish = "已完成"
      console.log(this.wt[this.id])
      storage.set({
        key: "wt",
        value: JSON.stringify(this.wt)
      })
      storage.get({
        key: "stone",
        success: (res) => {
          let stone = res ? parseInt(res, 10) : 0
          stone += 15
          storage.set({
            key: "stone",
            value: stone
          })
        }
      })
      prompt.showToast({
        message: "获得15原石",
        duration: 3000
      })
      router.back()
    }
  }
}
</script>

<style>
.page {
  width: 192px;
  height: 490px;
  background-color: black;
}

.back {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 72px;
  height: 72px;
  opacity: 1;
  z-index: 1000;
}

.text1 {
  position: absolute;
  left: 0;
  top: 70px;
  width: 100%;
  height: 80px;
  text-align: center;
  color: white;
  background-color: rgb(0, 0, 0);
}
.a {
  position: absolute;
  left: 0;
  top: 150px;
  width: 100%;
  text-align: center;
  color: white;
  background-color: rgb(0, 0, 0);
}
.about {
  position: absolute;
  left: 30px;
  top: 10px;
  width: 85px;
  height: auto;
  opacity: 1;
}

.about1 {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
}
</style>
