<script>
// 导入模块
import router from "@system.router"

export default {
  Pagehh() {
    // 跳转到应用内的某个页面，当前页面无法返回
    router.replace({
      uri: "/pages/index_delete"
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  }
