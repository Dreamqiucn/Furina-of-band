      this.realmonster = "丘丘人"
      this.remind = "“有一点原始”"
      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "丘丘人"
            }
          })
      }, 1000)
    } else if (this.monster === 2) {
      this.realmonster = "丘丘暴徒"
      this.remind = "“也很原始”"

      this.timer = setInterval(() => {
        if (this.timeLeft > 0) {
          this.timeLeft--
        } else
          router.push({
            uri: "/pages/maoxian_nostop",
            params: {
              which: "丘丘暴徒"
            }
          })
      }, 1000)
