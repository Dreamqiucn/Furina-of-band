  width: 192px;
  height: 490px;
  background-color: black;
}

.back {
  position: absolute;
  left: 6px;
  top: 6px;
  width: 72px;
  height: 72px;
  opacity: 1;
  z-index: 1000;
}

.text {
  position: absolute;
  left: 0;
  top: 70px;
  width: 100%;
  height: 80px;
  text-align: center;
  color: white;
  background-color: rgb(0, 0, 0);
}

.about {
  position: absolute;
  left: 49.69px;
  top: 6.63px;
  width: 112.62px;
  height: 79.5px;
  opacity: 1;
}
.about1 {
  position: absolute;
  left: 100px;
  top: 10px;
  width: 65px;
  height: 65px;
  opacity: 1;
}
</style>
